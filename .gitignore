.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ===================================
# IDEs and Editors
# ===================================
# VS Code (keep workspace settings with .example extension)
.vscode/
!.vscode/*.example

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Editor temp files
*.swp
*.swo
*~

# ===================================
# OS Files
# ===================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ===================================
# Security - Keys (NEVER commit)
# ===================================
infra/keys/*.pem
infra/sops/age-key.txt
*.pem
*.key

# ===================================
# SOPS Config (keep)
# ===================================
!.sops.yaml

# ===================================
# SOPS Secrets
# ===================================
# Keep encrypted secrets
!infra/sops/secrets.enc.yaml
# Ignore decrypted/plaintext secrets
infra/sops/secrets.yaml
infra/sops/secrets.dec.yaml
.env.secrets

# ===================================
# Temporary and misc
# ===================================
*.log
logs/
*.tmp
*.temp
*.bak
tmp/
.tmp/

# Tilt
.tilt/

# Gateway static assets (built from clients)
src/gateway/Gateway/wwwroot/login/
src/gateway/Gateway/wwwroot/app/

# Generated protos (commit these if you want reproducible builds)
# src/services/*/proto/
