# ===================================
# Dotfiles and Dot Folders
# ===================================
# Ignore all dotfiles
.*

# Exception: Keep .gitignore
!.gitignore

# Exception: Keep .*.example files
!.*.example

# Ignore all dot folders
.*/

# ===================================
# Markdown Files
# ===================================
*.md

