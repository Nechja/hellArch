# Multi-stage build for Gateway with embedded Vue App
# This Dockerfile should be run from the repo root context

# Stage 1: Build Vue App client
FROM node:22-slim AS app-build
WORKDIR /src

# Copy design system first (dependency)
COPY libs/design/ ./libs/design/

# Copy and build Vue app
COPY src/clients/App/package*.json ./App/
WORKDIR /src/App
RUN npm install

COPY src/clients/App/ ./
RUN npm run build

# Stage 2: Build Gateway with static files
FROM mcr.microsoft.com/dotnet/sdk:10.0-preview AS gateway-build
WORKDIR /src

# Copy Vue App output to Gateway wwwroot
COPY --from=app-build /src/App/dist /src/Gateway/wwwroot/app

# Copy Gateway project and restore
COPY src/gateway/Gateway/*.csproj ./Gateway/
RUN dotnet restore Gateway/Gateway.csproj

# Copy Gateway source and build
COPY src/gateway/Gateway/ ./Gateway/
RUN dotnet publish Gateway/Gateway.csproj -c Release -o /gateway-out

# Stage 3: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0-preview AS runtime
WORKDIR /app

COPY --from=gateway-build /gateway-out .

ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000

ENTRYPOINT ["dotnet", "Gateway.dll"]
