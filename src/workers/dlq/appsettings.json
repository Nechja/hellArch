{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQ": {
    "QueueName": "hellarch.events.dlq",
    "MainExchange": "hellarch.events"
  },
  "DLQ": {
    "MaxRetries": 3,
    "BaseDelaySeconds": 5
  },
  "EventsApi": {
    "Url": "http://events-api:8080"
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4318"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5025"
      }
    }
  }
}
