<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LoginProjectPath>../../../clients/Login/Login.csproj</LoginProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.76.0" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" Version="10.0.1" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.11.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.11.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.11.2" />
  </ItemGroup>

  <!-- Build Login WASM client and copy to wwwroot/login -->
  <Target Name="BuildLoginClient" BeforeTargets="Build" Condition="'$(BuildLogin)' == 'true'">
    <Message Importance="High" Text="Building Login WASM client..." />
    <Exec Command="dotnet publish $(LoginProjectPath) -c $(Configuration) -o $(IntermediateOutputPath)login-publish" />
    <ItemGroup>
      <LoginFiles Include="$(IntermediateOutputPath)login-publish/wwwroot/**/*" />
    </ItemGroup>
    <MakeDir Directories="$(ProjectDir)wwwroot/login" />
    <Copy SourceFiles="@(LoginFiles)" DestinationFolder="$(ProjectDir)wwwroot/login/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="High" Text="Login WASM client copied to wwwroot/login" />
  </Target>

  <!-- Clean Login artifacts -->
  <Target Name="CleanLoginClient" AfterTargets="Clean">
    <RemoveDir Directories="$(ProjectDir)wwwroot/login" />
  </Target>

  <!-- Build Vue App client and copy to wwwroot/app -->
  <Target Name="BuildAppClient" BeforeTargets="Build" Condition="'$(BuildApp)' == 'true'">
    <PropertyGroup>
      <AppClientPath>$(ProjectDir)../../../clients/App</AppClientPath>
    </PropertyGroup>
    <Message Importance="High" Text="Building Vue App client..." />
    <Exec Command="npm install" WorkingDirectory="$(AppClientPath)" />
    <Exec Command="npm run build" WorkingDirectory="$(AppClientPath)" />
    <ItemGroup>
      <AppFiles Include="$(AppClientPath)/dist/**/*" />
    </ItemGroup>
    <MakeDir Directories="$(ProjectDir)wwwroot/app" />
    <Copy SourceFiles="@(AppFiles)" DestinationFolder="$(ProjectDir)wwwroot/app/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="High" Text="Vue App client copied to wwwroot/app" />
  </Target>

  <!-- Clean App artifacts -->
  <Target Name="CleanAppClient" AfterTargets="Clean">
    <RemoveDir Directories="$(ProjectDir)wwwroot/app" />
  </Target>

</Project>
