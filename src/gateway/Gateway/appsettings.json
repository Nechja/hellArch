{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "CookieName": "hellarch_session",
    "ProtectedPaths": ["/admin"],
    "LoginPath": "/app/login",
    "DefaultRedirect": "/app",
    "ValidateEndpoint": "http://hellarch-auth:5001/auth/validate",
    "PermissionRoutes": {
      "/admin": "admin.panel",
      "/api/admin": "admin.panel",
      "/api/auth/admin": "admin.panel",
      "/api/events": "admin.panel",
      "/api/testing": "admin.panel",
      "/api/health": "admin.panel"
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:5010"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin" },
          { "X-Forwarded": "Set" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/admin" }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "hubs-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "events-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/events" }
        ]
      },
      "files-route": {
        "ClusterId": "files-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      },
      "identity-api-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "testing-route": {
        "ClusterId": "testing-cluster",
        "Match": {
          "Path": "/api/testing/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/testing" }
        ]
      },
      "health-route": {
        "ClusterId": "health-cluster",
        "Match": {
          "Path": "/api/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/health" }
        ]
      }
    },
    "Clusters": {
      "admin-cluster": {
        "Destinations": {
          "admin-service": {
            "Address": "http://hellarch-admin:5003"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://hellarch-auth:5001"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://hellarch-user:5002"
          }
        }
      },
      "realtime-cluster": {
        "Destinations": {
          "realtime-service": {
            "Address": "http://hellarch-realtime-worker:5020"
          }
        }
      },
      "events-cluster": {
        "Destinations": {
          "events-service": {
            "Address": "http://hellarch-events:5005"
          }
        }
      },
      "files-cluster": {
        "Destinations": {
          "files-service": {
            "Address": "http://hellarch-files:5006"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://hellarch-identity:5010"
          }
        }
      },
      "testing-cluster": {
        "Destinations": {
          "testing-service": {
            "Address": "http://hellarch-testing:5007"
          }
        }
      },
      "health-cluster": {
        "Destinations": {
          "health-service": {
            "Address": "http://hellarch-health:5004"
          }
        }
      }
    }
  }
}
