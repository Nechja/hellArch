@page "/events"
@using HellArch.CloudEvents
@using Admin.Services
@using Admin.Components.Shared.Panels
@implements IDisposable
@inject IRabbitMqAdapter RabbitMq
@inject IEventsAdminFacade EventsApi
@inject RealtimeHubService RealtimeHub
@inject LiveUpdateService LiveUpdate
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Events> Logger

<PageTitle>Events - HellArch Admin</PageTitle>

<PageHeader Title="Events" Subtitle="Real-time event monitoring, audit logs, webhooks, and infrastructure." />

@* Persistent Live Events Header *@
<EventsLiveHeader Events="@_liveEvents" ConnectionStatus="@_connectionStatus" />

@* Tabbed Interface *@
<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mt-2" @bind-ActivePanelIndex="_activeTab">
    <MudTabPanel Text="Audit Log" Icon="@Icons.Material.Filled.History">
        <div class="pa-4">
            <AuditPanel
                AuditLogs="@_auditLogs"
                TotalCount="@_auditTotalCount"
                Page="@_auditPage"
                PageSize="@AuditPageSize"
                Loading="@_loadingAudit"
                EventTypeFilter="@_eventTypeFilter"
                EventTypeFilterChanged="@(v => _eventTypeFilter = v)"
                ActorIdFilter="@_actorIdFilter"
                ActorIdFilterChanged="@(v => _actorIdFilter = v)"
                OnApplyFilters="ApplyAuditFilters"
                OnClearFilters="ClearAuditFilters"
                OnPrevious="PreviousAuditPage"
                OnNext="NextAuditPage" />
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Webhooks" Icon="@Icons.Material.Filled.Webhook">
        <div class="pa-4">
            <WebhooksPanel
                Webhooks="@_webhooks"
                Loading="@_loadingWebhooks"
                OnCreate="CreateWebhook"
                OnUpdate="UpdateWebhook"
                OnDelete="DeleteWebhook" />
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Event Types" Icon="@Icons.Material.Filled.Category">
        <div class="pa-4">
            <EventTypesPanel />
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Infrastructure" Icon="@Icons.Material.Filled.Storage">
        <div class="pa-4">
            <InfraPanel
                Overview="@_overview"
                Queues="@_queues"
                Exchanges="@_exchanges"
                Loading="@_loadingInfra" />
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab;
    private readonly List<CloudEventDto> _liveEvents = [];
    private string _connectionStatus = "Connecting...";
    private const int MaxLiveEvents = 25;
    private DateTime _lastHealthRefresh = DateTime.MinValue;
    private static readonly TimeSpan HealthRefreshDebounce = TimeSpan.FromSeconds(5);

    // Audit state
    private IReadOnlyList<AuditLog> _auditLogs = [];
    private int _auditTotalCount;
    private int _auditPage = 1;
    private const int AuditPageSize = 20;
    private bool _loadingAudit;
    private string? _eventTypeFilter;
    private string? _actorIdFilter;

    // Webhooks state
    private IReadOnlyList<Webhook> _webhooks = [];
    private bool _loadingWebhooks;

    // Infrastructure state
    private RabbitMqOverview? _overview;
    private IReadOnlyList<QueueInfo> _queues = [];
    private IReadOnlyList<ExchangeInfo> _exchanges = [];
    private bool _loadingInfra;

    protected override async Task OnInitializedAsync()
    {
        RealtimeHub.OnEventReceived += HandleEventReceived;
        RealtimeHub.OnConnectionStateChanged += HandleConnectionStateChanged;
        LiveUpdate.OnHealthUpdate += HandleHealthUpdate;
        LiveUpdate.OnWebhookUpdate += HandleWebhookUpdate;
        _connectionStatus = RealtimeHub.ConnectionStateText;

        var sessionToken = HttpContextAccessor.HttpContext?.Items["SessionToken"] as string;
        if (!string.IsNullOrEmpty(sessionToken))
        {
            await RealtimeHub.Connect(sessionToken);
            _connectionStatus = RealtimeHub.ConnectionStateText;
        }
        else
        {
            Logger.LogWarning("No session token available for realtime hub connection");
            _connectionStatus = "No Auth";
        }

        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        var auditTask = LoadAuditLogs();
        var webhooksTask = LoadWebhooks();
        var infraTask = LoadInfrastructure();
        await Task.WhenAll(auditTask, webhooksTask, infraTask);
    }

    // Live Events
    private void HandleEventReceived(object? sender, CloudEventReceivedEventArgs e)
    {
        InvokeAsync(() =>
        {
            _liveEvents.Insert(0, e.CloudEvent);
            if (_liveEvents.Count > MaxLiveEvents)
            {
                _liveEvents.RemoveAt(_liveEvents.Count - 1);
            }
            StateHasChanged();
        });
    }

    private void HandleConnectionStateChanged(object? sender, ConnectionStateChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            _connectionStatus = e.State;
            StateHasChanged();
        });
    }

    private void HandleHealthUpdate(object? sender, EventArgs e)
    {
        if (DateTime.UtcNow - _lastHealthRefresh < HealthRefreshDebounce) return;

        InvokeAsync(async () =>
        {
            _lastHealthRefresh = DateTime.UtcNow;
            await LoadInfrastructure();
            StateHasChanged();
        });
    }

    private void HandleWebhookUpdate(object? sender, UpdateEventArgs e)
    {
        InvokeAsync(async () => await LoadWebhooks());
    }

    // Audit
    private async Task LoadAuditLogs()
    {
        _loadingAudit = true;
        StateHasChanged();

        var response = await EventsApi.GetAuditLogs(_auditPage, AuditPageSize, _eventTypeFilter, _actorIdFilter);
        _auditLogs = response.Data;
        _auditTotalCount = response.TotalCount;

        _loadingAudit = false;
        StateHasChanged();
    }

    private async Task ApplyAuditFilters()
    {
        _auditPage = 1;
        await LoadAuditLogs();
    }

    private async Task ClearAuditFilters()
    {
        _eventTypeFilter = null;
        _actorIdFilter = null;
        _auditPage = 1;
        await LoadAuditLogs();
    }

    private async Task NextAuditPage()
    {
        _auditPage++;
        await LoadAuditLogs();
    }

    private async Task PreviousAuditPage()
    {
        if (_auditPage > 1)
        {
            _auditPage--;
            await LoadAuditLogs();
        }
    }

    // Webhooks
    private async Task LoadWebhooks()
    {
        _loadingWebhooks = true;
        StateHasChanged();

        var response = await EventsApi.GetWebhooks(1, 100);
        _webhooks = response.Data;

        _loadingWebhooks = false;
        StateHasChanged();
    }

    private async Task CreateWebhook(Webhook webhook)
    {
        var request = new CreateWebhookRequest(webhook.Name, webhook.Url, webhook.Secret, webhook.EventTypes.ToList(), webhook.Format, webhook.IsActive);
        await EventsApi.CreateWebhook(request);
        await LoadWebhooks();
    }

    private async Task UpdateWebhook(Webhook webhook)
    {
        var request = new UpdateWebhookRequest(webhook.Name, webhook.Url, webhook.Secret, webhook.EventTypes.ToList(), webhook.Format, webhook.IsActive);
        await EventsApi.UpdateWebhook(webhook.Id, request);
        await LoadWebhooks();
    }

    private async Task DeleteWebhook(string id)
    {
        await EventsApi.DeleteWebhook(id);
        await LoadWebhooks();
    }

    // Infrastructure
    private async Task LoadInfrastructure()
    {
        _loadingInfra = true;
        StateHasChanged();

        _overview = await RabbitMq.GetOverview();
        _queues = await RabbitMq.GetQueues();
        _exchanges = await RabbitMq.GetExchanges();

        _loadingInfra = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        RealtimeHub.OnEventReceived -= HandleEventReceived;
        RealtimeHub.OnConnectionStateChanged -= HandleConnectionStateChanged;
        LiveUpdate.OnHealthUpdate -= HandleHealthUpdate;
        LiveUpdate.OnWebhookUpdate -= HandleWebhookUpdate;
    }
}
