@page "/events"
@inject Admin.Services.RabbitMqAdapter RabbitMq
@inject ILogger<Events> Logger

<PageTitle>Events - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-6">Events</h1>

<p class="text-text-secondary mb-6">
    View CloudEvents published through RabbitMQ and queue statistics.
</p>

<section class="mb-8">
    <h2 class="text-heading mb-4 text-glitch">RabbitMQ Overview</h2>
    @if (_overview == null)
    {
        <p class="text-text-secondary text-center py-4">Loading...</p>
    }
    else
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="stat-card">
                <span class="stat-value">@(_overview.QueueTotals?.Messages ?? 0)</span>
                <span class="stat-label">Messages</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@(_overview.ObjectTotals?.Queues ?? 0)</span>
                <span class="stat-label">Queues</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@(_overview.ObjectTotals?.Consumers ?? 0)</span>
                <span class="stat-label">Consumers</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@(_overview.ObjectTotals?.Connections ?? 0)</span>
                <span class="stat-label">Connections</span>
            </div>
        </div>
    }
</section>

<section class="mb-8">
    <h2 class="text-heading mb-4 text-glitch">Queues</h2>
    @if (_queues.Count == 0)
    {
        <p class="text-text-muted text-center py-4 italic">No queues found</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="data-th">Queue</th>
                        <th class="data-th">Messages</th>
                        <th class="data-th">Ready</th>
                        <th class="data-th">Unacked</th>
                        <th class="data-th">Consumers</th>
                        <th class="data-th">State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var queue in _queues)
                    {
                        <tr class="data-row">
                            <td class="data-td font-mono text-sm">@queue.Name</td>
                            <td class="data-td">@queue.Messages</td>
                            <td class="data-td">@queue.MessagesReady</td>
                            <td class="data-td">@queue.MessagesUnacknowledged</td>
                            <td class="data-td">@queue.Consumers</td>
                            <td class="data-td"><span class="@GetStateClass(queue.State)">@queue.State</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="mb-8">
    <h2 class="text-heading mb-4 text-glitch">Exchanges</h2>
    @if (_exchanges.Count == 0)
    {
        <p class="text-text-muted text-center py-4 italic">No custom exchanges found</p>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @foreach (var exchange in _exchanges)
            {
                <div class="card">
                    <h3 class="font-bold text-neon-cyan mb-2">@exchange.Name</h3>
                    <p class="text-sm text-text-secondary">Type: @exchange.Type</p>
                    <p class="text-xs text-text-muted mt-1">@(exchange.Durable ? "Durable" : "Transient")</p>
                </div>
            }
        </div>
    }
</section>

<section class="mb-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-heading text-glitch">Recent Events</h2>
        <button class="btn-secondary" @onclick="LoadRecentEvents">Refresh</button>
    </div>
    @if (_loadingEvents)
    {
        <p class="text-text-secondary text-center py-4">Loading events...</p>
    }
    else if (_recentEvents.Count == 0)
    {
        <p class="text-text-muted text-center py-4 italic">No events in queue (events are consumed by workers)</p>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var evt in _recentEvents)
            {
                <div class="card">
                    <div class="flex items-center justify-between mb-2">
                        <span class="badge-info">@evt.GetEventTypeName()</span>
                        <span class="text-xs text-text-muted font-mono">@evt.Time</span>
                    </div>
                    <div class="flex gap-4 text-xs text-text-muted mb-2">
                        <span>ID: @evt.Id</span>
                        <span>Source: @evt.Source</span>
                    </div>
                    <details class="mt-2">
                        <summary class="cursor-pointer text-sm text-neon-cyan hover:underline">View Data</summary>
                        <pre class="mt-2 p-3 rounded-sm bg-bg-secondary border border-border font-mono text-xs overflow-x-auto">@evt.GetFormattedData()</pre>
                    </details>
                </div>
            }
        </div>
    }
</section>

<section class="card border-l-2 border-neon-cyan">
    <h2 class="text-subheading mb-3">External Tools</h2>
    <div class="flex gap-4">
        <a href="http://localhost:15672" target="_blank" rel="noopener" class="link">
            RabbitMQ Management Console
        </a>
        <a href="http://localhost:16686" target="_blank" rel="noopener" class="link">
            Jaeger Tracing
        </a>
    </div>
</section>

@code {
    private Admin.Services.RabbitMqOverview? _overview;
    private IReadOnlyList<Admin.Services.QueueInfo> _queues = [];
    private IReadOnlyList<Admin.Services.ExchangeInfo> _exchanges = [];
    private IReadOnlyList<Admin.Services.CloudEventMessage> _recentEvents = [];
    private bool _loadingEvents;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _overview = await RabbitMq.GetOverview();
        _queues = await RabbitMq.GetQueues();
        _exchanges = await RabbitMq.GetExchanges();
        await LoadRecentEvents();
    }

    private async Task LoadRecentEvents()
    {
        _loadingEvents = true;
        StateHasChanged();

        _recentEvents = await RabbitMq.GetRecentEvents(20);

        _loadingEvents = false;
        StateHasChanged();
    }

    private static string GetStateClass(string state) => state?.ToLower() switch
    {
        "running" => "badge-success",
        "idle" => "badge-warning",
        _ => "badge"
    };
}
