@page "/events"
@using HellArch.CloudEvents
@using Admin.Services
@implements IDisposable
@inject RabbitMqAdapter RabbitMq
@inject RealtimeHubService RealtimeHub
@inject LiveUpdateService LiveUpdate
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Events> Logger

<PageTitle>Events - HellArch Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    Events
</MudText>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    View CloudEvents published through RabbitMQ and queue statistics.
</MudText>

@*
TODO: Rebuild this page with MudBlazor
Original functionality:
- Live Events section: Real-time CloudEvents via SignalR (RealtimeHub.OnEventReceived)
  - Shows event type badge, timestamp, source, user ID
  - Expandable data section with formatted JSON
  - Max 25 events in list, newest first
  - Connection status indicator (Connected/Reconnecting/Disconnected)

- RabbitMQ Overview section: MetricCards showing:
  - Total Messages (_overview.QueueTotals.Messages)
  - Queue Count (_overview.ObjectTotals.Queues)
  - Consumer Count (_overview.ObjectTotals.Consumers)
  - Connection Count (_overview.ObjectTotals.Connections)

- Queues table: Name, Messages, Ready, Unacked, Consumers, State
  - State shown as badge (running=green, idle=yellow)

- Exchanges grid: Name, Type, Durable/Transient

- Recent Events section: CloudEventMessage list from RabbitMq.GetRecentEvents(20)
  - Event type badge, timestamp, ID, source
  - Expandable formatted data section
  - Refresh button

- External links: RabbitMQ Management Console, Jaeger Tracing
*@

<MudAlert Severity="Severity.Info" Class="mb-6">
    This page is being rebuilt with MudBlazor. See source comments for original functionality.
</MudAlert>

<MudGrid Class="mb-6">
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4" Color="Color.Primary">@((_overview?.QueueTotals?.Messages ?? 0))</MudText>
            <MudText Typo="Typo.caption">Messages</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4" Color="Color.Primary">@((_overview?.ObjectTotals?.Queues ?? 0))</MudText>
            <MudText Typo="Typo.caption">Queues</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4" Color="Color.Primary">@((_overview?.ObjectTotals?.Consumers ?? 0))</MudText>
            <MudText Typo="Typo.caption">Consumers</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4" Color="Color.Primary">@((_overview?.ObjectTotals?.Connections ?? 0))</MudText>
            <MudText Typo="Typo.caption">Connections</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h6" Class="mb-4">Queues</MudText>
<MudTable Items="@_queues" Hover="true" Striped="true" Dense="true" T="QueueInfo" Class="mb-6">
    <HeaderContent>
        <MudTh>Queue</MudTh>
        <MudTh>Messages</MudTh>
        <MudTh>Ready</MudTh>
        <MudTh>Unacked</MudTh>
        <MudTh>Consumers</MudTh>
        <MudTh>State</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Style="font-family: 'JetBrains Mono', monospace;">@context.Name</MudTd>
        <MudTd>@context.Messages</MudTd>
        <MudTd>@context.MessagesReady</MudTd>
        <MudTd>@context.MessagesUnacknowledged</MudTd>
        <MudTd>@context.Consumers</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@(context.State == "running" ? Color.Success : Color.Warning)">
                @context.State
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudText Typo="Typo.h6" Class="mb-4">External Tools</MudText>
<MudButtonGroup Variant="Variant.Outlined">
    <MudButton Href="http://localhost:15672" Target="_blank">RabbitMQ Management</MudButton>
    <MudButton Href="http://localhost:16686" Target="_blank">Jaeger Tracing</MudButton>
</MudButtonGroup>

@code {
    private RabbitMqOverview? _overview;
    private IReadOnlyList<QueueInfo> _queues = [];

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnHealthUpdate += HandleHealthUpdate;
        await LoadData();
    }

    private void HandleHealthUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _overview = await RabbitMq.GetOverview();
        _queues = await RabbitMq.GetQueues();
    }

    public void Dispose()
    {
        LiveUpdate.OnHealthUpdate -= HandleHealthUpdate;
    }
}
