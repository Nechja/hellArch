@page "/tests"
@implements IDisposable
@inject ITestsAdminFacade TestsAdmin
@inject Admin.Services.LiveUpdateService LiveUpdate
@inject ILogger<Tests> Logger

<PageTitle>Tests - HellArch Admin</PageTitle>

<PageHeader Title="Tests" />

@* Test Controls *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                <MudButton OnClick="@(() => TriggerTests("smoke"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.Speed">
                    Smoke
                </MudButton>
                <MudButton OnClick="@(() => TriggerTests("contract"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.Description">
                    Contract
                </MudButton>
                <MudButton OnClick="@(() => TriggerTests("errors"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.Error">
                    Errors
                </MudButton>
                <MudButton OnClick="@(() => TriggerTests("integration"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.Link">
                    Integration
                </MudButton>
                <MudButton OnClick="@(() => TriggerTests("golden"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.Star">
                    Golden
                </MudButton>
                <MudButton OnClick="@(() => TriggerTests("e2e"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.DesktopWindows">
                    E2E
                </MudButton>
                <MudButton OnClick="@(() => TriggerTests("all"))" Disabled="@_triggering" StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Secondary">
                    All
                </MudButton>
            </MudButtonGroup>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center justify-end gap-2">
            @if (_serviceStatus.Status == "ready")
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">Ready</MudChip>
            }
            else if (_serviceStatus.Status == "unavailable")
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small">Unavailable</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small">@_serviceStatus.Status</MudChip>
            }
            @if (_serviceStatus.RunningTests.Count > 0)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                    Running: @string.Join(", ", _serviceStatus.RunningTests.Keys)
                </MudChip>
            }
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_triggerMessage))
    {
        <MudAlert Severity="@_triggerSeverity" Class="mt-3" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="@(() => _triggerMessage = null)">
            @_triggerMessage
        </MudAlert>
    }
</MudPaper>

@* Stats Cards *@
<MudGrid Class="mb-6">
    <MudItem xs="6" md="3">
        <MetricCard Value="@_stats.TotalRuns.ToString()" Label="Total Runs" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MetricCard Value="@_stats.RecentPassed.ToString()" Label="Recent Passed" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MetricCard Value="@_stats.RecentFailed.ToString()" Label="Recent Failed" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MetricCard Value="@PassRate" Label="Pass Rate" />
    </MudItem>
</MudGrid>

@* Golden Path Failures Alert *@
@if (_goldenFailures.Data.Count > 0)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Icon="@Icons.Material.Filled.Error">
        <MudText Typo="Typo.subtitle2">@_goldenFailures.Data.Count Golden Path Failure(s)</MudText>
        @foreach (var failure in _goldenFailures.Data.Take(3))
        {
            <MudText Typo="Typo.body2">
                <strong>@failure.TestName</strong> failed at step <code>@failure.FailedStep</code>
            </MudText>
        }
    </MudAlert>
}

@* Filters *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="string" Label="Category" Value="@_selectedCategory" ValueChanged="OnCategoryChanged" Clearable="true">
                <MudSelectItem Value="@("smoke")">Smoke</MudSelectItem>
                <MudSelectItem Value="@("contract")">Contract</MudSelectItem>
                <MudSelectItem Value="@("errors")">Errors</MudSelectItem>
                <MudSelectItem Value="@("integration")">Integration</MudSelectItem>
                <MudSelectItem Value="@("golden")">Golden Path</MudSelectItem>
                <MudSelectItem Value="@("e2e")">E2E</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string" Label="Result" Value="@_selectedResultFilter" ValueChanged="OnResultChanged" Clearable="true">
                <MudSelectItem Value="@("passed")">Passed</MudSelectItem>
                <MudSelectItem Value="@("failed")">Failed</MudSelectItem>
                <MudSelectItem Value="@("error")">Error</MudSelectItem>
                <MudSelectItem Value="@("skipped")">Skipped</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadData" StartIcon="@Icons.Material.Filled.Refresh">
                Refresh
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* Test Results *@
<SectionHeader Title="Recent Test Results" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_results.Data.Count == 0)
{
    <EmptyState Message="No test results found" Icon="@Icons.Material.Filled.Science" />
}
else
{
    <MudTable Items="@_results.Data" Hover="true" Elevation="1" Dense="true" Class="mb-4"
              @bind-SelectedItem="_selectedTestResult" T="TestResult">
        <HeaderContent>
            <MudTh Style="width: 40px;"></MudTh>
            <MudTh>Test Name</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Result</MudTh>
            <MudTh>Duration</MudTh>
            <MudTh>Timestamp</MudTh>
            <MudTh>Details</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="width: 40px;">
                @if (!string.IsNullOrEmpty(context.Error))
                {
                    <MudIconButton Icon="@(_expandedRows.Contains(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   Size="Size.Small" OnClick="@(() => ToggleRow(context.Id))" />
                }
            </MudTd>
            <MudTd DataLabel="Test Name">
                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.TestName</MudText>
            </MudTd>
            <MudTd DataLabel="Category">
                <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(context.Category)">
                    @context.Category
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Result">
                <MudChip T="string" Size="Size.Small" Color="@GetResultColor(context.Result)" Variant="Variant.Filled">
                    @context.Result
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Duration">@context.DurationMs ms</MudTd>
            <MudTd DataLabel="Timestamp">@context.Timestamp.ToString("g")</MudTd>
            <MudTd DataLabel="Details">
                @if (context.Critical)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Critical</MudChip>
                }
                @if (!string.IsNullOrEmpty(context.Error))
                {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" Class="ml-1" />
                }
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_expandedRows.Contains(context.Id) && !string.IsNullOrEmpty(context.Error))
            {
                <MudTr>
                    <td colspan="7" class="pa-4" style="background-color: var(--mud-palette-background-grey);">
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-0">
                            <MudText Typo="Typo.body2" Style="font-family: monospace; white-space: pre-wrap;">@context.Error</MudText>
                        </MudAlert>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
    </MudTable>

    <Pagination
        Page="@_page"
        PageSize="@_pageSize"
        TotalCount="@_results.TotalCount"
        DisplayedCount="@_results.Data.Count"
        OnPrevious="@OnPreviousPage"
        OnNext="@OnNextPage" />
}

@* E2E Test Results *@
<div class="mt-6">
    <SectionHeader Title="E2E Test Results" />
</div>

@if (_e2eResults.Data.Count > 0)
{
    <MudTable Items="@_e2eResults.Data" Hover="true" Elevation="1" Dense="true" Class="mb-4">
        <HeaderContent>
            <MudTh>Test Name</MudTh>
            <MudTh>Result</MudTh>
            <MudTh>Duration</MudTh>
            <MudTh>Screenshots</MudTh>
            <MudTh>Timestamp</MudTh>
            <MudTh>Details</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Test Name">
                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.TestName</MudText>
            </MudTd>
            <MudTd DataLabel="Result">
                <MudChip T="string" Size="Size.Small" Color="@GetResultColor(context.Result)" Variant="Variant.Filled">
                    @context.Result
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Duration">@context.DurationMs ms</MudTd>
            <MudTd DataLabel="Screenshots">
                @if (context.Screenshots.Count > 0)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => ShowScreenshots(context))">
                        @context.Screenshots.Count screenshot(s)
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.caption">None</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Timestamp">@context.Timestamp.ToString("g")</MudTd>
            <MudTd DataLabel="Details">
                @if (context.Critical)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Critical</MudChip>
                }
                @if (!string.IsNullOrEmpty(context.FailedStep))
                {
                    <MudTooltip Text="@($"Failed at: {context.FailedStep}")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@context.FailedStep</MudChip>
                    </MudTooltip>
                }
                @if (!string.IsNullOrEmpty(context.Error))
                {
                    <MudTooltip Text="@context.Error">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No E2E test results yet</MudText>
}

@* Screenshot Dialog *@
<MudDialog @bind-Visible="_showScreenshots" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Screenshots - @_selectedE2eTest?.TestName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedE2eTest != null)
        {
            <MudGrid>
                @foreach (var screenshot in _selectedE2eTest.Screenshots)
                {
                    <MudItem xs="12" md="6">
                        <MudCard Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@screenshot.StepName</MudText>
                                <MudImage Src="@($"/api/files/{screenshot.FileId}")"
                                          Alt="@screenshot.StepName"
                                          ObjectFit="ObjectFit.Contain"
                                          Class="rounded"
                                          Style="width: 100%; max-height: 400px;" />
                                <MudText Typo="Typo.caption" Class="mt-1">@screenshot.CapturedAt.ToString("g")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showScreenshots = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@* Test Run Summaries *@
<div class="mt-6">
    <SectionHeader Title="Test Run History" />
</div>

@if (_summaries.Data.Count > 0)
{
    <MudTable Items="@_summaries.Data" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Category</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Passed</MudTh>
            <MudTh>Failed</MudTh>
            <MudTh>Duration</MudTh>
            <MudTh>Timestamp</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(context.Category)">
                    @context.Category
                </MudChip>
            </MudTd>
            <MudTd>@context.Total</MudTd>
            <MudTd>
                <MudText Color="Color.Success">@context.Passed</MudText>
            </MudTd>
            <MudTd>
                <MudText Color="@(context.Failed > 0 ? Color.Error : Color.Default)">@context.Failed</MudText>
            </MudTd>
            <MudTd>@context.DurationMs ms</MudTd>
            <MudTd>@context.Timestamp.ToString("g")</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No test runs recorded yet</MudText>
}

@code {
    private TestResultsResponse _results = new([], 0, 1, 20);
    private TestRunSummariesResponse _summaries = new([], 0, 1, 10);
    private GoldenPathFailuresResponse _goldenFailures = new([], 0, 1, 10);
    private E2eTestResultsResponse _e2eResults = new([], 0, 1, 20);
    private TestStats _stats = new(0, 0, 0, 0, null, null);
    private TestingServiceStatus _serviceStatus = new("testing", "unknown", new Dictionary<string, string>(), false, 0, 0, 0, 0, 0, 0);

    private bool _showScreenshots;
    private E2eTestResult? _selectedE2eTest;
    private TestResult? _selectedTestResult;
    private readonly HashSet<string> _expandedRows = new();

    private bool _loading = true;
    private bool _triggering;
    private string? _triggerMessage;
    private Severity _triggerSeverity = Severity.Info;
    private int _page = 1;
    private readonly int _pageSize = 20;
    private string? _selectedCategory;
    private string? _selectedResultFilter;

    private string PassRate => _stats.RecentTotal > 0
        ? $"{(_stats.RecentPassed * 100 / _stats.RecentTotal)}%"
        : "N/A";

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnHealthUpdate += HandleUpdate;
        await LoadData();
    }

    private void HandleUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var resultsTask = TestsAdmin.GetTestResults(_page, _pageSize, _selectedCategory, _selectedResultFilter);
            var summariesTask = TestsAdmin.GetTestRunSummaries(1, 10, _selectedCategory);
            var goldenTask = TestsAdmin.GetGoldenPathFailures(1, 5);
            var e2eTask = TestsAdmin.GetE2eTestResults(1, 20);
            var statsTask = TestsAdmin.GetTestStats();
            var statusTask = TestsAdmin.GetTestingServiceStatus();

            await Task.WhenAll(resultsTask, summariesTask, goldenTask, e2eTask, statsTask, statusTask);

            _results = await resultsTask;
            _summaries = await summariesTask;
            _goldenFailures = await goldenTask;
            _e2eResults = await e2eTask;
            _stats = await statsTask;
            _serviceStatus = await statusTask;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load test data");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task TriggerTests(string category)
    {
        _triggering = true;
        _triggerMessage = null;
        StateHasChanged();

        try
        {
            var response = category switch
            {
                "smoke" => await TestsAdmin.TriggerSmokeTests(),
                "contract" => await TestsAdmin.TriggerContractTests(),
                "errors" => await TestsAdmin.TriggerErrorTests(),
                "integration" => await TestsAdmin.TriggerIntegrationTests(),
                "golden" => await TestsAdmin.TriggerGoldenTests(),
                "e2e" => await TestsAdmin.TriggerE2eTests(),
                "all" => await TestsAdmin.TriggerAllTests(),
                _ => new TriggerResponse("error", category, "Unknown category")
            };

            _triggerMessage = response.Message;
            _triggerSeverity = response.Status switch
            {
                "started" => Severity.Success,
                "already_running" => Severity.Warning,
                _ => Severity.Error
            };

            // Refresh service status after triggering
            _serviceStatus = await TestsAdmin.GetTestingServiceStatus();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to trigger {Category} tests", category);
            _triggerMessage = $"Failed to trigger {category} tests";
            _triggerSeverity = Severity.Error;
        }
        finally
        {
            _triggering = false;
            StateHasChanged();
        }
    }

    private async Task OnCategoryChanged(string? category)
    {
        _selectedCategory = category;
        _page = 1;
        await LoadData();
    }

    private async Task OnResultChanged(string? result)
    {
        _selectedResultFilter = result;
        _page = 1;
        await LoadData();
    }

    private void ToggleRow(string id)
    {
        if (!_expandedRows.Remove(id))
        {
            _expandedRows.Add(id);
        }
    }

    private async Task OnPreviousPage()
    {
        _page--;
        await LoadData();
    }

    private async Task OnNextPage()
    {
        _page++;
        await LoadData();
    }

    private void ShowScreenshots(E2eTestResult test)
    {
        _selectedE2eTest = test;
        _showScreenshots = true;
    }

    private static Color GetCategoryColor(string category) => category.ToLowerInvariant() switch
    {
        "smoke" => Color.Info,
        "contract" => Color.Primary,
        "errors" => Color.Error,
        "integration" => Color.Secondary,
        "golden" => Color.Warning,
        "e2e" => Color.Tertiary,
        _ => Color.Default
    };

    private static Color GetResultColor(string result) => result.ToLowerInvariant() switch
    {
        "passed" => Color.Success,
        "failed" => Color.Error,
        "error" => Color.Error,
        "skipped" => Color.Warning,
        _ => Color.Default
    };

    public void Dispose()
    {
        LiveUpdate.OnHealthUpdate -= HandleUpdate;
    }
}
