@page "/sessions"
@using Admin.Services
@implements IDisposable
@inject AuthAdminFacade AuthAdmin
@inject LiveUpdateService LiveUpdate

<PageTitle>Sessions - HellArch Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    Active Sessions
</MudText>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    View and manage all active user sessions. Sessions are created when users log in via OAuth.
</MudText>

<MudPaper Class="pa-4 mb-6" Elevation="2">
    <MudText Typo="Typo.h4" Color="Color.Primary">@_stats.SessionCount</MudText>
    <MudText Typo="Typo.caption">Total Active Sessions</MudText>
</MudPaper>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
    To view or revoke sessions for a specific user, go to the
    <MudLink Href="users">Users</MudLink> page and select a user.
</MudAlert>

@code {
    private AdminStats _stats = new(0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnStatsUpdate += HandleStatsUpdate;
        LiveUpdate.OnSessionUpdate += HandleSessionUpdate;
        _stats = await AuthAdmin.GetStats();
    }

    private void HandleStatsUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            _stats = await AuthAdmin.GetStats();
            StateHasChanged();
        });
    }

    private void HandleSessionUpdate(object? sender, UpdateEventArgs e)
    {
        InvokeAsync(async () =>
        {
            _stats = await AuthAdmin.GetStats();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LiveUpdate.OnStatsUpdate -= HandleStatsUpdate;
        LiveUpdate.OnSessionUpdate -= HandleSessionUpdate;
    }
}
