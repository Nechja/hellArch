@page "/sessions"
@inject AuthAdminFacade AuthAdmin

<PageTitle>Sessions - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-6">Active Sessions</h1>

<p class="text-text-secondary mb-6">
    View and manage all active user sessions. Sessions are created when users log in via OAuth.
</p>

<section class="mb-8">
    <div class="stat-card inline-block">
        <h3 class="stat-label">Total Active</h3>
        <p class="stat-value">@_stats.SessionCount</p>
    </div>
</section>

<section class="card border-l-2 border-neon-cyan">
    <p class="text-text-secondary">
        To view or revoke sessions for a specific user, go to the
        <a href="users" class="link">Users</a> page and select a user.
    </p>
</section>

@code {
    private AdminStats _stats = new(0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        _stats = await AuthAdmin.GetStats();
    }
}
