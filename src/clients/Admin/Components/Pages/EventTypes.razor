@page "/event-types"

<PageTitle>Event Types - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-6">Event Types</h1>

<p class="text-text-secondary mb-6">
    Reference for all available event types that can be used with webhooks. Use wildcards like <code class="text-neon-pink">hellarch.auth.*</code> to match multiple events.
</p>

<section class="mb-6">
    <div class="flex flex-wrap gap-2">
        <Button Variant="@(_selectedDomain == null ? ButtonVariant.Primary : ButtonVariant.Secondary)"
                Size="ButtonSize.Small"
                OnClick="() => _selectedDomain = null">
            All (@Admin.Services.EventTypeCatalog.All.Count)
        </Button>
        @foreach (var domain in Admin.Services.EventTypeCatalog.Domains)
        {
            var count = Admin.Services.EventTypeCatalog.GetByDomain(domain).Count;
            <Button Variant="@(_selectedDomain == domain ? ButtonVariant.Primary : ButtonVariant.Secondary)"
                    Size="ButtonSize.Small"
                    OnClick="() => _selectedDomain = domain">
                @domain (@count)
            </Button>
        }
    </div>
</section>

<section>
    @foreach (var domain in GetDisplayedDomains())
    {
        <div class="mb-8">
            <h2 class="text-heading mb-4">@domain</h2>
            <div class="grid gap-3">
                @foreach (var eventType in Admin.Services.EventTypeCatalog.GetByDomain(domain))
                {
                    <div class="card hover:border-neon-pink/30 transition-colors cursor-pointer" @onclick="() => CopyEventType(eventType.Type)">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1">
                                    <code class="text-sm text-neon-pink break-all">@eventType.Type</code>
                                    <Badge Variant="GetBadgeVariant(eventType.Severity)" Size="BadgeSize.Small">
                                        @eventType.Severity
                                    </Badge>
                                </div>
                                <p class="text-text-secondary text-sm">@eventType.Description</p>
                            </div>
                            <button class="text-text-muted hover:text-white text-xs shrink-0" title="Copy to clipboard">
                                📋
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</section>

@if (_copiedType != null)
{
    <div class="fixed bottom-4 right-4 bg-bg-elevated border border-border rounded-lg px-4 py-2 shadow-lg enter-fade">
        <span class="text-sm">Copied: <code class="text-neon-pink">@_copiedType</code></span>
    </div>
}

@code {
    private string? _selectedDomain;
    private string? _copiedType;
    private System.Timers.Timer? _copyTimer;

    private IEnumerable<string> GetDisplayedDomains()
    {
        if (_selectedDomain != null)
        {
            return [_selectedDomain];
        }
        return Admin.Services.EventTypeCatalog.Domains;
    }

    private async Task CopyEventType(string eventType)
    {
        _copiedType = eventType;
        StateHasChanged();

        // Reset after 2 seconds
        _copyTimer?.Stop();
        _copyTimer?.Dispose();
        _copyTimer = new System.Timers.Timer(2000);
        _copyTimer.Elapsed += (_, _) =>
        {
            _copiedType = null;
            InvokeAsync(StateHasChanged);
        };
        _copyTimer.AutoReset = false;
        _copyTimer.Start();

        // Note: Actual clipboard copy would need JS interop
        await Task.CompletedTask;
    }

    private static BadgeVariant GetBadgeVariant(Admin.Services.EventSeverity severity) => severity switch
    {
        Admin.Services.EventSeverity.Critical => BadgeVariant.Danger,
        Admin.Services.EventSeverity.High => BadgeVariant.Warning,
        Admin.Services.EventSeverity.Medium => BadgeVariant.Info,
        _ => BadgeVariant.Default
    };

    public void Dispose()
    {
        _copyTimer?.Stop();
        _copyTimer?.Dispose();
    }
}
