@page "/event-types"
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Event Types - HellArch Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    Event Types
</MudText>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    Subscribe to events to get webhook notifications. Click any event to create a webhook.
</MudText>

@*
TODO: Rebuild this page with MudBlazor
Original functionality:
- Domain filter buttons at top: All (count), auth (count), infra (count)
  - Clicking filters to show only that domain's events

- Event cards for each event type showing:
  - Event type code (e.g. hellarch.auth.user.created.v1) in pink
  - Severity badge (Critical=red, High=yellow, Medium=blue, Low=default)
  - Description text
  - "+ Subscribe" button opens QuickSubscribe modal
  - Copy button copies event type to clipboard

- Toast notifications:
  - "Copied: {eventType}" on copy
  - "Subscribed to {shortType}" on successful subscription

- QuickSubscribe modal (separate component):
  - Shows event type and severity badge
  - Two modes: New webhook / Add to existing
  - New: URL input, Format selection (Discord/Slack/Raw), Name input
  - Existing: Dropdown of existing webhooks (disabled if already subscribed)
  - Cancel/Subscribe buttons

Key services:
- EventTypeCatalog.All, Domains, GetByDomain(domain)
- EventSeverity enum: Critical, High, Medium, Low
*@

<MudAlert Severity="Severity.Info" Class="mb-6">
    This page is being rebuilt with MudBlazor. See source comments for original functionality.
</MudAlert>

<MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="mb-6">
    <MudButton Color="@(_selectedDomain == null ? Color.Primary : Color.Default)" OnClick="() => _selectedDomain = null">
        All (@Admin.Services.EventTypeCatalog.All.Count)
    </MudButton>
    @foreach (var domain in Admin.Services.EventTypeCatalog.Domains)
    {
        var count = Admin.Services.EventTypeCatalog.GetByDomain(domain).Count;
        <MudButton Color="@(_selectedDomain == domain ? Color.Primary : Color.Default)" OnClick="() => _selectedDomain = domain">
            @domain (@count)
        </MudButton>
    }
</MudButtonGroup>

@foreach (var domain in GetDisplayedDomains())
{
    <MudText Typo="Typo.h6" Class="mb-4 mt-6">@domain</MudText>
    <MudGrid Class="mb-4">
        @foreach (var eventType in Admin.Services.EventTypeCatalog.GetByDomain(domain))
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <div class="d-flex justify-space-between align-start">
                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Style="font-family: 'JetBrains Mono', monospace; color: #D162A4; font-size: 0.875rem; word-break: break-all;">
                                    @eventType.Type
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(eventType.Severity)">
                                    @eventType.Severity
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@eventType.Description</MudText>
                        </div>
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudButton Color="Color.Primary" OnClick="() => Subscribe(eventType.Type)">Subscribe</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" OnClick="() => CopyEventType(eventType.Type)" />
                        </MudButtonGroup>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private string? _selectedDomain;

    private IEnumerable<string> GetDisplayedDomains()
    {
        return _selectedDomain != null ? [_selectedDomain] : Admin.Services.EventTypeCatalog.Domains;
    }

    private async Task CopyEventType(string eventType)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", eventType);
        Snackbar.Add($"Copied: {eventType}", Severity.Success);
    }

    private void Subscribe(string eventType)
    {
        // TODO: Open subscribe dialog
        Snackbar.Add($"Subscribe dialog not yet implemented for: {eventType}", Severity.Info);
    }

    private static Color GetSeverityColor(Admin.Services.EventSeverity severity) => severity switch
    {
        Admin.Services.EventSeverity.Critical => Color.Error,
        Admin.Services.EventSeverity.High => Color.Warning,
        Admin.Services.EventSeverity.Medium => Color.Info,
        _ => Color.Default
    };
}
