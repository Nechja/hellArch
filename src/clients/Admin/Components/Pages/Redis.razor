@page "/redis"
@inject RedisBrowserAdapter RedisBrowser

<PageTitle>Redis Browser - HellArch Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    Redis Browser
</MudText>

<MudChip T="string" Color="@(_connectionInfo.IsConnected ? Color.Success : Color.Error)" Size="Size.Small" Class="mb-6">
    @(_connectionInfo.IsConnected ? "Connected" : "Disconnected")
</MudChip>

<MudGrid Class="mb-6">
    <MudItem xs="12" md="8">
        <MudTextField @bind-Value="_pattern" Label="Pattern" Placeholder="e.g., session:*, oauth:*" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Search" FullWidth="true" Class="mt-2">Search</MudButton>
    </MudItem>
</MudGrid>

<MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="mb-6">
    <MudButton OnClick='() => SearchPattern("session:*")'>Sessions</MudButton>
    <MudButton OnClick='() => SearchPattern("oauth:state:*")'>OAuth States</MudButton>
    <MudButton OnClick='() => SearchPattern("revoked:*")'>Revoked Tokens</MudButton>
    <MudButton OnClick='() => SearchPattern("*")'>All Keys</MudButton>
</MudButtonGroup>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Keys (@_keys.Count)</MudText>
            @if (_keys.Count > 0)
            {
                <MudList T="string" Dense="true" Style="max-height: 400px; overflow-y: auto;">
                    @foreach (var key in _keys)
                    {
                        <MudListItem T="string" OnClick="() => SelectKey(key.Key)"
                                     Style="@(_selectedKey == key.Key ? "background-color: var(--mud-palette-primary-darken);" : "")">
                            <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                <MudText Style="font-family: 'JetBrains Mono', monospace; font-size: 0.875rem;" Class="text-truncate">@key.Key</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Size="Size.Small">@key.Type</MudChip>
                                    @if (key.Ttl.HasValue)
                                    {
                                        <MudText Typo="Typo.caption">@FormatTtl(key.Ttl.Value)</MudText>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
            else if (_searched)
            {
                <MudText Color="Color.Secondary">No keys found matching "@_pattern"</MudText>
            }
            else
            {
                <MudText Color="Color.Secondary">Enter a pattern and click Search</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Key Detail</MudText>
            @if (_keyDetail is not null)
            {
                <MudSimpleTable Dense="true" Class="mb-4">
                    <tbody>
                        <tr>
                            <td><MudText Typo="Typo.caption">Key</MudText></td>
                            <td><MudText Style="font-family: 'JetBrains Mono', monospace; word-break: break-all;">@_keyDetail.Key</MudText></td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.caption">Type</MudText></td>
                            <td><MudChip T="string" Size="Size.Small" Color="Color.Info">@_keyDetail.Type</MudChip></td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.caption">TTL</MudText></td>
                            <td>@(_keyDetail.Ttl.HasValue ? FormatTtl(_keyDetail.Ttl.Value) : "No expiry")</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Value</MudText>
                <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-gray); max-height: 250px; overflow: auto;">
                    <pre style="font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; margin: 0; white-space: pre-wrap;">@_keyDetail.Value</pre>
                </MudPaper>

                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteSelectedKey">Delete Key</MudButton>
            }
            else
            {
                <MudText Color="Color.Secondary">Select a key to view details</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _pattern = "*";
    private bool _searched;
    private IReadOnlyList<RedisKeyInfo> _keys = [];
    private string? _selectedKey;
    private RedisKeyDetail? _keyDetail;
    private RedisConnectionInfo _connectionInfo = new(false, [], "");

    protected override void OnInitialized()
    {
        _connectionInfo = RedisBrowser.GetConnectionInfo();
    }

    private async Task Search()
    {
        _keys = await RedisBrowser.ScanKeys(_pattern);
        _searched = true;
        _selectedKey = null;
        _keyDetail = null;
    }

    private async Task SearchPattern(string pattern)
    {
        _pattern = pattern;
        await Search();
    }

    private async Task SelectKey(string key)
    {
        _selectedKey = key;
        _keyDetail = await RedisBrowser.GetKeyDetail(key);
    }

    private async Task DeleteSelectedKey()
    {
        if (_selectedKey is not null)
        {
            var success = await RedisBrowser.DeleteKey(_selectedKey);
            if (success)
            {
                await Search();
            }
        }
    }

    private static string FormatTtl(TimeSpan ttl)
    {
        if (ttl.TotalDays >= 1)
            return $"{ttl.Days}d {ttl.Hours}h";
        if (ttl.TotalHours >= 1)
            return $"{ttl.Hours}h {ttl.Minutes}m";
        if (ttl.TotalMinutes >= 1)
            return $"{ttl.Minutes}m {ttl.Seconds}s";
        return $"{ttl.Seconds}s";
    }
}
