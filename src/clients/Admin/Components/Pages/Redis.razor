@page "/redis"
@inject RedisBrowserAdapter RedisBrowser

<PageTitle>Redis Browser - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-6">Redis Browser</h1>

<section class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-sm @(_connectionInfo.IsConnected ? "bg-neon-green/10 text-neon-green" : "bg-neon-red/10 text-neon-red")">
        <HealthDot Status="@(_connectionInfo.IsConnected ? HealthDot.HealthStatus.Healthy : HealthDot.HealthStatus.Danger)" />
        <span class="text-sm font-medium">@(_connectionInfo.IsConnected ? "Connected" : "Disconnected")</span>
    </div>
</section>

<section class="mb-6">
    <div class="flex gap-2 mb-3">
        <Input @bind-Value="_pattern" Placeholder="Pattern (e.g., session:*, oauth:*)" Class="flex-1" />
        <Button Variant="ButtonVariant.Neon" OnClick="Search">Search</Button>
    </div>
    <div class="flex gap-2 flex-wrap">
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick='() => SearchPattern("session:*")'>Sessions</Button>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick='() => SearchPattern("oauth:state:*")'>OAuth States</Button>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick='() => SearchPattern("revoked:*")'>Revoked Tokens</Button>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick='() => SearchPattern("*")'>All Keys</Button>
    </div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <section class="card">
        <h2 class="text-heading mb-4 text-glitch">Keys (@_keys.Count)</h2>
        @if (_keys.Count > 0)
        {
            <ul class="flex flex-col gap-1 max-h-96 overflow-y-auto">
                @foreach (var key in _keys)
                {
                    <li class="flex items-center gap-2 p-2 rounded-sm cursor-pointer transition-colors @(_selectedKey == key.Key ? "bg-bg-secondary border border-neon-pink" : "hover:bg-bg-elevated")"
                        @onclick="() => SelectKey(key.Key)">
                        <span class="font-mono text-sm truncate flex-1">@key.Key</span>
                        <span class="badge">@key.Type</span>
                        @if (key.Ttl.HasValue)
                        {
                            <span class="text-xs text-text-muted">@FormatTtl(key.Ttl.Value)</span>
                        }
                    </li>
                }
            </ul>
        }
        else if (_searched)
        {
            <p class="text-text-muted text-center py-4 italic">No keys found matching "@_pattern"</p>
        }
        else
        {
            <p class="text-text-muted text-center py-4 italic">Enter a pattern and click Search</p>
        }
    </section>

    <section class="card">
        <h2 class="text-heading mb-4 text-glitch">Key Detail</h2>
        @if (_keyDetail is not null)
        {
            <dl class="grid grid-cols-[80px_1fr] gap-2 mb-4">
                <dt class="text-xs uppercase text-text-muted">Key</dt>
                <dd class="font-mono text-sm break-all">@_keyDetail.Key</dd>
                <dt class="text-xs uppercase text-text-muted">Type</dt>
                <dd><Badge Variant="BadgeVariant.Info">@_keyDetail.Type</Badge></dd>
                <dt class="text-xs uppercase text-text-muted">TTL</dt>
                <dd>@(_keyDetail.Ttl.HasValue ? FormatTtl(_keyDetail.Ttl.Value) : "No expiry")</dd>
            </dl>
            <div class="mb-4">
                <h3 class="text-sm font-semibold text-text-secondary mb-2">Value</h3>
                <pre class="p-4 rounded-sm bg-bg-secondary border border-border overflow-x-auto font-mono text-sm max-h-64 overflow-y-auto">@_keyDetail.Value</pre>
            </div>
            <div class="pt-4 border-t border-border">
                <Button Variant="ButtonVariant.Danger" OnClick="DeleteSelectedKey">Delete Key</Button>
            </div>
        }
        else
        {
            <p class="text-text-muted text-center py-4 italic">Select a key to view details</p>
        }
    </section>
</div>

@code {
    private string _pattern = "*";
    private bool _searched;
    private IReadOnlyList<RedisKeyInfo> _keys = [];
    private string? _selectedKey;
    private RedisKeyDetail? _keyDetail;
    private RedisConnectionInfo _connectionInfo = new(false, [], "");

    protected override void OnInitialized()
    {
        _connectionInfo = RedisBrowser.GetConnectionInfo();
    }

    private async Task Search()
    {
        _keys = await RedisBrowser.ScanKeys(_pattern);
        _searched = true;
        _selectedKey = null;
        _keyDetail = null;
    }

    private async Task SearchPattern(string pattern)
    {
        _pattern = pattern;
        await Search();
    }

    private async Task SelectKey(string key)
    {
        _selectedKey = key;
        _keyDetail = await RedisBrowser.GetKeyDetail(key);
    }

    private async Task DeleteSelectedKey()
    {
        if (_selectedKey is not null)
        {
            var success = await RedisBrowser.DeleteKey(_selectedKey);
            if (success)
            {
                await Search();
            }
        }
    }

    private static string FormatTtl(TimeSpan ttl)
    {
        if (ttl.TotalDays >= 1)
            return $"{ttl.Days}d {ttl.Hours}h";
        if (ttl.TotalHours >= 1)
            return $"{ttl.Hours}h {ttl.Minutes}m";
        if (ttl.TotalMinutes >= 1)
            return $"{ttl.Minutes}m {ttl.Seconds}s";
        return $"{ttl.Seconds}s";
    }
}
