*@

<MudAlert Severity="Severity.Info" Class="mb-6">
    This page is being rebuilt with MudBlazor. See source comments for original functionality.
</MudAlert>

@if (_loadingWebhooks)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_webhooks.Count == 0)
{
    <MudPaper Class="pa-8 text-center" Elevation="2">
        <MudText Color="Color.Secondary" Class="mb-4">No webhooks configured yet.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateForm">Create your first webhook</MudButton>
    </MudPaper>
}
else
{
    <MudGrid>
        @foreach (var webhook in _webhooks)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="2">
                    <div class="d-flex justify-space-between align-start">
                        <div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.h6">@webhook.Name</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(webhook.IsActive ? Color.Success : Color.Warning)">
                                    @(webhook.IsActive ? "Active" : "Inactive")
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@GetFormatLabel(webhook.Format)</MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Style="font-family: 'JetBrains Mono', monospace;" Color="Color.Secondary" Class="mb-2">
                                @TruncateUrl(webhook.Url)
                            </MudText>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var eventType in webhook.EventTypes.Take(3))
                                {
                                    <MudChip T="string" Size="Size.Small">@GetShortEventType(eventType)</MudChip>
                                }
                                @if (webhook.EventTypes.Count > 3)
                                {
                                    <MudChip T="string" Size="Size.Small">+@(webhook.EventTypes.Count - 3) more</MudChip>
                                }
                            </div>
                        </div>
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudButton OnClick="() => EditWebhook(webhook)">Edit</MudButton>
                            <MudButton Color="Color.Error" OnClick="() => ConfirmDelete(webhook)">Delete</MudButton>
                        </MudButtonGroup>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@* Create/Edit Dialog *@
<MudDialog @bind-Visible="_showForm">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingWebhook == null ? "Create Webhook" : "Edit Webhook")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_formName" Label="Name" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="_formUrl" Label="URL" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="_formSecret" Label="Secret (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudSelect @bind-Value="_formFormat" Label="Format" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem Value="WebhookFormat.Raw">Raw JSON</MudSelectItem>
            <MudSelectItem Value="WebhookFormat.Discord">Discord</MudSelectItem>
            <MudSelectItem Value="WebhookFormat.Slack">Slack</MudSelectItem>
        </MudSelect>
        <MudSwitch @bind-Value="_formIsActive" Label="Active" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveWebhook" Disabled="@(_saving || !IsFormValid)">
            @(_saving ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@* Delete Confirmation *@
<MudDialog @bind-Visible="_showDeleteConfirm">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Webhook</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete <strong>@_webhookToDelete?.Name</strong>? This cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDeleteConfirm = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteWebhook">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<Webhook> _webhooks = [];
    private bool _loadingWebhooks = true;

    private bool _showForm;
    private Webhook? _editingWebhook;
    private string _formName = "";
    private string _formUrl = "";
    private string _formSecret = "";
    private WebhookFormat _formFormat = WebhookFormat.Discord;
    private bool _formIsActive = true;
    private bool _saving;

    private bool IsFormValid => !string.IsNullOrWhiteSpace(_formName) && !string.IsNullOrWhiteSpace(_formUrl);

    private bool _showDeleteConfirm;
    private Webhook? _webhookToDelete;

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnWebhookUpdate += HandleWebhookUpdate;
        await LoadWebhooks();
    }

    private void HandleWebhookUpdate(object? sender, UpdateEventArgs e)
    {
        InvokeAsync(async () => await LoadWebhooks());
    }

    private async Task LoadWebhooks()
    {
        _loadingWebhooks = true;
        StateHasChanged();

        var response = await EventsApi.GetWebhooks(1, 100);
        _webhooks = response.Data;

        _loadingWebhooks = false;
        StateHasChanged();
    }

    private void ShowCreateForm()
    {
        _editingWebhook = null;
        _formName = "";
        _formUrl = "";
        _formSecret = "";
        _formFormat = WebhookFormat.Discord;
        _formIsActive = true;
        _showForm = true;
    }

    private void EditWebhook(Webhook webhook)
    {
        _editingWebhook = webhook;
        _formName = webhook.Name;
        _formUrl = webhook.Url;
        _formSecret = webhook.Secret;
        _formFormat = webhook.Format;
        _formIsActive = webhook.IsActive;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _editingWebhook = null;
    }

    private async Task SaveWebhook()
    {
        if (!IsFormValid) return;

        _saving = true;
        StateHasChanged();

        // TODO: Add event type selection
        var eventTypes = _editingWebhook?.EventTypes.ToList() ?? ["hellarch.auth.user.created.v1"];

        if (_editingWebhook == null)
        {
            var request = new CreateWebhookRequest(_formName, _formUrl, _formSecret, eventTypes, _formFormat, _formIsActive);
            await EventsApi.CreateWebhook(request);
            Snackbar.Add("Webhook created", Severity.Success);
        }
        else
        {
            var request = new UpdateWebhookRequest(_formName, _formUrl, _formSecret, eventTypes, _formFormat, _formIsActive);
            await EventsApi.UpdateWebhook(_editingWebhook.Id, request);
            Snackbar.Add("Webhook updated", Severity.Success);
        }

        _saving = false;
        CloseForm();
        await LoadWebhooks();
    }

    private void ConfirmDelete(Webhook webhook)
    {
        _webhookToDelete = webhook;
        _showDeleteConfirm = true;
    }

    private async Task DeleteWebhook()
    {
        if (_webhookToDelete != null)
        {
            await EventsApi.DeleteWebhook(_webhookToDelete.Id);
            Snackbar.Add("Webhook deleted", Severity.Success);
            _webhookToDelete = null;
            _showDeleteConfirm = false;
            await LoadWebhooks();
        }
    }

    private static string GetShortEventType(string eventType)
    {
        var parts = eventType.Split('.');
        return parts.Length >= 4 ? $"{parts[^3]}.{parts[^2]}" : eventType;
    }

    private static string GetFormatLabel(WebhookFormat format) => format switch
    {
        WebhookFormat.Discord => "Discord",
        WebhookFormat.Slack => "Slack",
        _ => "Raw"
    };

    private static string TruncateUrl(string url)
    {
        const int maxLen = 50;
        return url.Length <= maxLen ? url : url[..(maxLen - 3)] + "...";
    }

    public void Dispose()
    {
        LiveUpdate.OnWebhookUpdate -= HandleWebhookUpdate;
    }
}
