@page "/webhooks"
@using Admin.Services
@implements IDisposable
@inject EventsAdminFacade EventsApi
@inject LiveUpdateService LiveUpdate
@inject ISnackbar Snackbar
@inject ILogger<Webhooks> Logger

<PageTitle>Webhooks - HellArch Admin</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.h4" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Webhooks
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage webhook endpoints for event notifications.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateForm" StartIcon="@Icons.Material.Filled.Add">
        New Webhook
    </MudButton>
</div>

@*
TODO: Rebuild this page with MudBlazor
