@page "/"
@implements IDisposable
@inject AuthAdminFacade AuthAdmin
@inject HealthAdapter Health
@inject Admin.Services.LiveUpdateService LiveUpdate
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - HellArch Admin</PageTitle>

<PageHeader Title="Dashboard" />

<MudGrid Class="mb-8">
    <MudItem xs="6" md="3">
        <MetricCard Value="@_stats.UserCount.ToString()" Label="Users" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MetricCard Value="@_stats.SessionCount.ToString()" Label="Active Sessions" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MetricCard Value="@_stats.LinkedAccountCount.ToString()" Label="Linked Accounts" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MetricCard Value="@QueuedMessages.ToString()" Label="Queued Messages" />
    </MudItem>
</MudGrid>

<SectionHeader Title="Service Health" />
@if (_healthStatus != null)
{
    <HealthStatusBar Label="System" Status="@_healthStatus.Overall" Timestamp="@_healthStatus.CheckedAt" />

    <MudGrid Class="mb-8">
        @foreach (var (name, info) in _healthStatus.Services.OrderBy(s => s.Key))
        {
            <MudItem xs="6" md="3">
                <ServiceHealthCard
                    Name="@HealthHelpers.FormatServiceName(name)"
                    Status="@info.Status"
                    LatencyMs="@info.LatencyMs"
                    HasError="@(!string.IsNullOrEmpty(info.Error))" />
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-8">Health service unavailable</MudAlert>
}

<SectionHeader Title="Worker Status" />
@if (_workersStatus != null)
{
    <HealthStatusBar Label="Workers" Status="@_workersStatus.Overall" />

    @if (_workersStatus.Workers.Count > 0)
    {
        <MudGrid Class="mb-8">
            @foreach (var worker in _workersStatus.Workers.OrderBy(w => w.Name))
            {
                <MudItem xs="12" md="4">
                    <WorkerCard
                        Name="@HealthHelpers.FormatWorkerName(worker.Name)"
                        Status="@worker.Status"
                        Consumers="@worker.Consumers"
                        Messages="@worker.Messages" />
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-8">No queues found</MudText>
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-8">Worker status unavailable</MudAlert>
}

@code {
    private AdminStats _stats = new(0, 0, 0);
    private AggregatedStatus? _healthStatus;
    private WorkersStatus? _workersStatus;

    private int QueuedMessages => _workersStatus?.Workers.Sum(w => w.Messages) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnHealthUpdate += HandleHealthUpdate;
        LiveUpdate.OnStatsUpdate += HandleStatsUpdate;

        await Task.WhenAll(
            LoadStats(),
            LoadHealth()
        );
    }

    private void HandleHealthUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            await LoadHealth();
            StateHasChanged();
        });
    }

    private void HandleStatsUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            await LoadStats();
            StateHasChanged();
        });
    }

    private async Task LoadStats()
    {
        try
        {
            _stats = await AuthAdmin.GetStats();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stats");
        }
    }

    private async Task LoadHealth()
    {
        try
        {
            var healthTask = Health.GetStatus();
            var workersTask = Health.GetWorkers();

            await Task.WhenAll(healthTask, workersTask);

            _healthStatus = await healthTask;
            _workersStatus = await workersTask;

            if (_healthStatus == null)
            {
                Logger.LogWarning("Health service unavailable");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load health status");
        }
    }

    public void Dispose()
    {
        LiveUpdate.OnHealthUpdate -= HandleHealthUpdate;
        LiveUpdate.OnStatsUpdate -= HandleStatsUpdate;
    }
}
