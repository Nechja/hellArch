@page "/"
@inject AuthAdminFacade AuthAdmin
@inject RedisBrowserAdapter RedisBrowser
@inject RabbitMqAdapter RabbitMq
@inject HealthAdapter Health
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-8">Dashboard</h1>

<section class="mb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <h3 class="stat-label">Users</h3>
            <p class="stat-value">@_stats.UserCount</p>
        </div>
        <div class="stat-card">
            <h3 class="stat-label">Active Sessions</h3>
            <p class="stat-value">@_stats.SessionCount</p>
        </div>
        <div class="stat-card">
            <h3 class="stat-label">Linked Accounts</h3>
            <p class="stat-value">@_stats.LinkedAccountCount</p>
        </div>
        <div class="stat-card">
            <h3 class="stat-label">Queued Messages</h3>
            <p class="stat-value">@_queuedMessages</p>
        </div>
    </div>
</section>

<section class="mb-12">
    <h2 class="text-heading mb-6 text-glitch">Service Health</h2>
    @if (_healthStatus != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-sm bg-bg-card border mb-4 @GetOverallBorderClass(_healthStatus.Overall)">
            <span class="@GetHealthDotClass(_healthStatus.Overall)"></span>
            <span class="font-semibold">System: @_healthStatus.Overall.ToUpperInvariant()</span>
            <span class="ml-auto text-xs text-text-muted font-mono">Last check: @FormatTime(_healthStatus.CheckedAt)</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
            @foreach (var (name, info) in _healthStatus.Services.OrderBy(s => s.Key))
            {
                <div class="card flex items-center gap-3">
                    <span class="@GetHealthDotClass(info.Status)"></span>
                    <div class="flex-1">
                        <span class="font-medium block">@FormatServiceName(name)</span>
                        <span class="text-xs text-text-muted">@info.Status</span>
                    </div>
                    <span class="text-xs font-mono text-text-muted">@info.LatencyMs ms</span>
                    @if (!string.IsNullOrEmpty(info.Error))
                    {
                        <span class="badge-danger" title="@info.Error">Error</span>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-4 rounded-sm bg-bg-card border border-neon-orange/50 text-center mb-4">
            <p class="text-neon-orange">Health service unavailable</p>
            <p class="text-xs text-text-muted mt-1">Falling back to direct checks...</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
            <div class="card flex items-center gap-3">
                <span class="@(_authHealthy ? "health-dot-healthy" : "health-dot-danger")"></span>
                <div class="flex-1">
                    <span class="font-medium block">Auth Service</span>
                    <span class="text-xs text-text-muted">@(_authHealthy ? "Healthy" : "Unhealthy")</span>
                </div>
            </div>
            <div class="card flex items-center gap-3">
                <span class="@(_userHealthy ? "health-dot-healthy" : "health-dot-danger")"></span>
                <div class="flex-1">
                    <span class="font-medium block">User Service</span>
                    <span class="text-xs text-text-muted">@(_userHealthy ? "Healthy" : "Unhealthy")</span>
                </div>
            </div>
            <div class="card flex items-center gap-3">
                <span class="@(_redisHealthy ? "health-dot-healthy" : "health-dot-danger")"></span>
                <div class="flex-1">
                    <span class="font-medium block">Redis</span>
                    <span class="text-xs text-text-muted">@(_redisHealthy ? "Connected" : "Disconnected")</span>
                </div>
            </div>
            <div class="card flex items-center gap-3">
                <span class="@(_rabbitmqHealthy ? "health-dot-healthy" : "health-dot-danger")"></span>
                <div class="flex-1">
                    <span class="font-medium block">RabbitMQ</span>
                    <span class="text-xs text-text-muted">@(_rabbitmqHealthy ? "Connected" : "Disconnected")</span>
                </div>
            </div>
        </div>
    }
</section>

<section class="mb-12">
    <h2 class="text-heading mb-6 text-glitch">Worker Status</h2>
    @if (_workersStatus != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-sm bg-bg-card border mb-4 @GetOverallBorderClass(_workersStatus.Overall)">
            <span class="@GetHealthDotClass(_workersStatus.Overall)"></span>
            <span class="font-semibold">Workers: @_workersStatus.Overall.ToUpperInvariant()</span>
        </div>
        @if (_workersStatus.Workers.Count > 0)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var worker in _workersStatus.Workers.OrderBy(w => w.Name))
                {
                    <div class="card">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="@GetHealthDotClass(worker.Status)"></span>
                            <span class="font-medium">@FormatWorkerName(worker.Name)</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm">
                            <div>
                                <span class="text-text-muted">Consumers:</span>
                                <span class="font-mono ml-1">@worker.Consumers</span>
                            </div>
                            <div>
                                <span class="text-text-muted">Messages:</span>
                                <span class="font-mono ml-1 @(worker.Messages > 100 ? "text-neon-orange" : "")">@worker.Messages</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-text-muted text-center p-4">No queues found</p>
        }
    }
    else
    {
        <div class="p-4 rounded-sm bg-bg-card border border-neon-orange/50 text-center">
            <p class="text-neon-orange">Worker status unavailable</p>
        </div>
    }
</section>

<section class="mb-12">
    <h2 class="text-heading mb-6 text-glitch">Quick Links</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
        <a href="http://localhost:16686" target="_blank" rel="noopener" class="card-glow block">
            <h3 class="font-bold text-neon-pink mb-1">Jaeger Tracing</h3>
            <p class="text-sm text-text-secondary">View distributed traces</p>
        </a>
        <a href="http://localhost:15672" target="_blank" rel="noopener" class="card-glow block">
            <h3 class="font-bold text-neon-rose mb-1">RabbitMQ Management</h3>
            <p class="text-sm text-text-secondary">Message queue dashboard</p>
        </a>
        <a href="http://localhost:5004/status" target="_blank" rel="noopener" class="card-glow block">
            <h3 class="font-bold text-neon-peach mb-1">Health API</h3>
            <p class="text-sm text-text-secondary">Raw health status JSON</p>
        </a>
    </div>
</section>

@code {
    private AdminStats _stats = new(0, 0, 0);
    private int _queuedMessages;
    private AggregatedStatus? _healthStatus;
    private WorkersStatus? _workersStatus;

    private bool _authHealthy;
    private bool _userHealthy;
    private bool _redisHealthy;
    private bool _rabbitmqHealthy;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadStats(),
            LoadHealth()
        );
    }

    private async Task LoadStats()
    {
        _stats = await AuthAdmin.GetStats();

        var overview = await RabbitMq.GetOverview();
        _queuedMessages = overview?.QueueTotals?.Messages ?? 0;
    }

    private async Task LoadHealth()
    {
        var healthTask = Health.GetStatus();
        var workersTask = Health.GetWorkers();

        await Task.WhenAll(healthTask, workersTask);

        _healthStatus = await healthTask;
        _workersStatus = await workersTask;

        if (_healthStatus == null)
        {
            Logger.LogWarning("Health service unavailable, using fallback checks");
            await FallbackHealthCheck();
        }
    }

    private async Task FallbackHealthCheck()
    {
        var redisInfo = RedisBrowser.GetConnectionInfo();
        _redisHealthy = redisInfo.IsConnected;

        var rabbitmqOverview = await RabbitMq.GetOverview();
        _rabbitmqHealthy = rabbitmqOverview != null;

        _authHealthy = true;
        _userHealthy = true;
    }

    private static string GetHealthDotClass(string status) => status.ToLower() switch
    {
        "healthy" => "health-dot-healthy",
        "degraded" => "health-dot-warning",
        _ => "health-dot-danger"
    };

    private static string GetOverallBorderClass(string status) => status.ToLower() switch
    {
        "healthy" => "border-neon-green",
        "degraded" => "border-neon-yellow",
        _ => "border-neon-red"
    };

    private static string FormatServiceName(string name) => name switch
    {
        "auth-db" => "Auth DB",
        "user-db" => "User DB",
        "rabbitmq" => "RabbitMQ",
        _ => char.ToUpper(name[0]) + name[1..]
    };

    private static string FormatWorkerName(string queueName)
    {
        // Convert queue names like "audit.events" to "Audit Events"
        var parts = queueName.Split('.', '_', '-');
        return string.Join(" ", parts.Select(p => char.ToUpper(p[0]) + p[1..]));
    }

    private static string FormatTime(string isoTime)
    {
        if (DateTime.TryParse(isoTime, out var dt))
        {
            return dt.ToLocalTime().ToString("HH:mm:ss");
        }
        return isoTime;
    }
}
