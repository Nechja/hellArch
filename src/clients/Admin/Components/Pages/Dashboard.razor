@page "/"
@inject AuthAdminFacade AuthAdmin
@inject RedisBrowserAdapter RedisBrowser
@inject RabbitMqAdapter RabbitMq
@inject HealthAdapter Health
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - HellArch Admin</PageTitle>

<h1>Dashboard</h1>

<section class="stats-grid">
    <div class="stat-card">
        <h3>Users</h3>
        <p class="stat-value">@_stats.UserCount</p>
    </div>
    <div class="stat-card">
        <h3>Active Sessions</h3>
        <p class="stat-value">@_stats.SessionCount</p>
    </div>
    <div class="stat-card">
        <h3>Linked Accounts</h3>
        <p class="stat-value">@_stats.LinkedAccountCount</p>
    </div>
    <div class="stat-card">
        <h3>Queued Messages</h3>
        <p class="stat-value">@_queuedMessages</p>
    </div>
</section>

<section class="health-section">
    <h2>Service Health</h2>
    @if (_healthStatus != null)
    {
        <div class="health-overall @_healthStatus.Overall">
            <span class="health-indicator"></span>
            <span>System: @_healthStatus.Overall.ToUpperInvariant()</span>
            <span class="health-time">Last check: @FormatTime(_healthStatus.CheckedAt)</span>
        </div>
        <div class="health-grid">
            @foreach (var (name, info) in _healthStatus.Services.OrderBy(s => s.Key))
            {
                <div class="health-card @info.Status">
                    <span class="health-indicator"></span>
                    <span class="health-name">@FormatServiceName(name)</span>
                    <span class="health-status">@info.Status</span>
                    <span class="health-latency">@info.LatencyMs ms</span>
                    @if (!string.IsNullOrEmpty(info.Error))
                    {
                        <span class="health-error" title="@info.Error">Error</span>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="health-unavailable">
            <p>Health service unavailable</p>
            <p class="health-fallback">Falling back to direct checks...</p>
        </div>
        <div class="health-grid">
            <div class="health-card @(_authHealthy ? "healthy" : "unhealthy")">
                <span class="health-indicator"></span>
                <span class="health-name">Auth Service</span>
                <span class="health-status">@(_authHealthy ? "Healthy" : "Unhealthy")</span>
            </div>
            <div class="health-card @(_userHealthy ? "healthy" : "unhealthy")">
                <span class="health-indicator"></span>
                <span class="health-name">User Service</span>
                <span class="health-status">@(_userHealthy ? "Healthy" : "Unhealthy")</span>
            </div>
            <div class="health-card @(_redisHealthy ? "healthy" : "unhealthy")">
                <span class="health-indicator"></span>
                <span class="health-name">Redis</span>
                <span class="health-status">@(_redisHealthy ? "Connected" : "Disconnected")</span>
            </div>
            <div class="health-card @(_rabbitmqHealthy ? "healthy" : "unhealthy")">
                <span class="health-indicator"></span>
                <span class="health-name">RabbitMQ</span>
                <span class="health-status">@(_rabbitmqHealthy ? "Connected" : "Disconnected")</span>
            </div>
        </div>
    }
</section>

<section class="links-section">
    <h2>Quick Links</h2>
    <div class="links-grid">
        <a href="http://localhost:16686" target="_blank" rel="noopener" class="link-card">
            <h3>Jaeger Tracing</h3>
            <p>View distributed traces</p>
        </a>
        <a href="http://localhost:15672" target="_blank" rel="noopener" class="link-card">
            <h3>RabbitMQ Management</h3>
            <p>Message queue dashboard</p>
        </a>
        <a href="http://localhost:5004/status" target="_blank" rel="noopener" class="link-card">
            <h3>Health API</h3>
            <p>Raw health status JSON</p>
        </a>
    </div>
</section>

@code {
    private AdminStats _stats = new(0, 0, 0);
    private int _queuedMessages;
    private AggregatedStatus? _healthStatus;

    // Fallback values when health service is unavailable
    private bool _authHealthy;
    private bool _userHealthy;
    private bool _redisHealthy;
    private bool _rabbitmqHealthy;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadStats(),
            LoadHealth()
        );
    }

    private async Task LoadStats()
    {
        _stats = await AuthAdmin.GetStats();

        var overview = await RabbitMq.GetOverview();
        _queuedMessages = overview?.QueueTotals?.Messages ?? 0;
    }

    private async Task LoadHealth()
    {
        // Try centralized health service first
        _healthStatus = await Health.GetStatus();

        // If health service is unavailable, fall back to direct checks
        if (_healthStatus == null)
        {
            Logger.LogWarning("Health service unavailable, using fallback checks");
            await FallbackHealthCheck();
        }
    }

    private async Task FallbackHealthCheck()
    {
        var redisInfo = RedisBrowser.GetConnectionInfo();
        _redisHealthy = redisInfo.IsConnected;

        var rabbitmqOverview = await RabbitMq.GetOverview();
        _rabbitmqHealthy = rabbitmqOverview != null;

        // Auth and User would need direct HTTP checks here if needed
        _authHealthy = true; // Assume healthy if we can't check
        _userHealthy = true;
    }

    private static string FormatServiceName(string name) => name switch
    {
        "auth-db" => "Auth DB",
        "user-db" => "User DB",
        "rabbitmq" => "RabbitMQ",
        _ => char.ToUpper(name[0]) + name[1..]
    };

    private static string FormatTime(string isoTime)
    {
        if (DateTime.TryParse(isoTime, out var dt))
        {
            return dt.ToLocalTime().ToString("HH:mm:ss");
        }
        return isoTime;
    }
}
