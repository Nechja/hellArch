@page "/users"
@page "/users/{UserId}"
@inject AuthAdminFacade AuthAdmin
@inject NavigationManager Navigation

<PageTitle>Users - HellArch Admin</PageTitle>

@if (UserId is null)
{
    <h1 class="text-display text-gradient mb-6">Users</h1>

    <div class="overflow-x-auto mb-4">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="data-th">ID</th>
                    <th class="data-th">Email</th>
                    <th class="data-th">Username</th>
                    <th class="data-th">Status</th>
                    <th class="data-th">Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr @onclick="() => ViewUser(user.Id)" class="data-row cursor-pointer">
                        <td class="data-td font-mono text-sm">@user.Id[..8]...</td>
                        <td class="data-td">@user.Email</td>
                        <td class="data-td">@user.Username</td>
                        <td class="data-td">
                            <span class="@(user.IsActive ? "badge-success" : "badge-danger")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="data-td">@user.CreatedAt.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="flex items-center justify-center gap-4 mt-4">
        <button disabled="@(_page <= 1)" @onclick="PrevPage" class="btn-secondary">Previous</button>
        <span class="text-text-secondary">Page @_page of @_totalPages</span>
        <button disabled="@(_page >= _totalPages)" @onclick="NextPage" class="btn-secondary">Next</button>
    </div>
}
else
{
    <div class="flex items-center gap-2 mb-4 text-sm text-text-muted">
        <a href="users" class="link">Users</a>
        <span>/</span>
        <span class="text-text-primary">@_userDetail?.Username</span>
    </div>

    <h1 class="text-display text-gradient mb-6">User Details</h1>

    @if (_userDetail is not null)
    {
        <section class="mb-8">
            <h2 class="text-heading mb-4 text-glitch">Profile</h2>
            <div class="card">
                <dl class="grid grid-cols-[120px_1fr] gap-2">
                    <dt class="text-xs uppercase text-text-muted">ID</dt>
                    <dd class="font-mono text-sm break-all">@_userDetail.Id</dd>
                    <dt class="text-xs uppercase text-text-muted">Email</dt>
                    <dd>@_userDetail.Email</dd>
                    <dt class="text-xs uppercase text-text-muted">Username</dt>
                    <dd>@_userDetail.Username</dd>
                    <dt class="text-xs uppercase text-text-muted">Status</dt>
                    <dd class="flex items-center gap-2">
                        <span class="@(_userDetail.IsActive ? "badge-success" : "badge-danger")">
                            @(_userDetail.IsActive ? "Active" : "Inactive")
                        </span>
                        @if (_userDetail.IsActive)
                        {
                            <button @onclick="DeactivateUser" class="btn-danger text-xs">Deactivate</button>
                        }
                        else
                        {
                            <button @onclick="ActivateUser" class="btn-success text-xs">Activate</button>
                        }
                    </dd>
                    <dt class="text-xs uppercase text-text-muted">Created</dt>
                    <dd>@_userDetail.CreatedAt.ToString("F")</dd>
                    <dt class="text-xs uppercase text-text-muted">Updated</dt>
                    <dd>@_userDetail.UpdatedAt.ToString("F")</dd>
                </dl>
            </div>
        </section>

        <section class="mb-8">
            <h2 class="text-heading mb-4 text-glitch">Permissions</h2>
            <div class="card">
                @if (_userDetail.Permissions is not null && _userDetail.Permissions.Count > 0)
                {
                    <div class="flex flex-col gap-2 mb-4">
                        @foreach (var perm in _userDetail.Permissions.Where(p => p.Value))
                        {
                            <div class="flex items-center justify-between p-2 rounded-sm bg-bg-secondary">
                                <span class="font-mono text-sm text-neon-pink">@perm.Key</span>
                                <button @onclick="() => RemovePermission(perm.Key)" class="btn-danger text-xs">Remove</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-text-muted text-center py-4 italic">No permissions assigned</p>
                }

                <div class="flex gap-2 pt-4 border-t border-border">
                    <input type="text" @bind="_newPermission" @bind:event="oninput"
                           placeholder="e.g. admin.users.write" class="input flex-1" />
                    <button @onclick="AddPermission" disabled="@string.IsNullOrWhiteSpace(_newPermission)"
                            class="btn-neon">
                        Grant Permission
                    </button>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h2 class="text-heading mb-4 text-glitch">Linked Accounts (@_userDetail.LinkedAccounts.Count)</h2>
            @if (_userDetail.LinkedAccounts.Count > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var account in _userDetail.LinkedAccounts)
                    {
                        <div class="card">
                            <div class="mb-3">
                                <span class="badge-info uppercase">@account.Provider</span>
                            </div>
                            <dl class="text-sm">
                                <dt class="text-text-muted text-xs mt-2">Provider ID</dt>
                                <dd class="font-mono">@account.ProviderUserId</dd>
                                @if (account.Email is not null)
                                {
                                    <dt class="text-text-muted text-xs mt-2">Email</dt>
                                    <dd>@account.Email</dd>
                                }
                                @if (account.Username is not null)
                                {
                                    <dt class="text-text-muted text-xs mt-2">Username</dt>
                                    <dd>@account.Username</dd>
                                }
                            </dl>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-text-muted text-center py-4 italic">No linked accounts</p>
            }
        </section>

        <section class="mb-8">
            <h2 class="text-heading mb-4 text-glitch">Sessions (@_sessions.Count)</h2>
            @if (_sessions.Count > 0)
            {
                <div class="overflow-x-auto">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="data-th">ID</th>
                                <th class="data-th">IP Address</th>
                                <th class="data-th">User Agent</th>
                                <th class="data-th">Expires</th>
                                <th class="data-th">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in _sessions)
                            {
                                <tr class="data-row">
                                    <td class="data-td font-mono text-sm">@session.Id[..8]...</td>
                                    <td class="data-td">@(session.IpAddress ?? "Unknown")</td>
                                    <td class="data-td truncate max-w-xs">@(session.UserAgent ?? "Unknown")</td>
                                    <td class="data-td">@session.ExpiresAt.ToString("g")</td>
                                    <td class="data-td">
                                        <button @onclick="() => RevokeSession(session.Id)" class="btn-danger text-xs">Revoke</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-text-muted text-center py-4 italic">No active sessions</p>
            }
        </section>
    }
    else
    {
        <p class="text-text-secondary text-center py-8">Loading...</p>
    }
}

@code {
    [Parameter]
    public string? UserId { get; set; }

    private IReadOnlyList<UserSummary> _users = [];
    private UserDetail? _userDetail;
    private IReadOnlyList<SessionInfo> _sessions = [];
    private int _page = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;
    private string _newPermission = "";

    protected override async Task OnParametersSetAsync()
    {
        if (UserId is null)
        {
            await LoadUsers();
        }
        else
        {
            await LoadUserDetail();
        }
    }

    private async Task LoadUsers()
    {
        var response = await AuthAdmin.GetUsers(_page, PageSize);
        _users = response.Users;
        _totalPages = (int)Math.Ceiling(response.TotalCount / (double)PageSize);
    }

    private async Task LoadUserDetail()
    {
        if (UserId is null) return;

        _userDetail = await AuthAdmin.GetUser(UserId);
        _sessions = await AuthAdmin.GetUserSessions(UserId);
    }

    private void ViewUser(string userId)
    {
        Navigation.NavigateTo($"users/{userId}");
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadUsers();
        }
    }

    private async Task NextPage()
    {
        if (_page < _totalPages)
        {
            _page++;
            await LoadUsers();
        }
    }

    private async Task RevokeSession(string sessionId)
    {
        var success = await AuthAdmin.RevokeSession(sessionId);
        if (success && UserId is not null)
        {
            await LoadUserDetail();
        }
    }

    private async Task AddPermission()
    {
        if (string.IsNullOrWhiteSpace(_newPermission) || UserId is null) return;

        var success = await AuthAdmin.GrantPermission(UserId, _newPermission.Trim());
        if (success)
        {
            _newPermission = "";
            await LoadUserDetail();
        }
    }

    private async Task RemovePermission(string permission)
    {
        if (UserId is null) return;

        var success = await AuthAdmin.RevokePermission(UserId, permission);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    private async Task ActivateUser()
    {
        if (UserId is null) return;

        var success = await AuthAdmin.ActivateUser(UserId);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    private async Task DeactivateUser()
    {
        if (UserId is null) return;

        var success = await AuthAdmin.DeactivateUser(UserId);
        if (success)
        {
            await LoadUserDetail();
        }
    }
}
