@page "/users"
@page "/users/{UserId}"
@inject AuthAdminFacade AuthAdmin
@inject NavigationManager Navigation

<PageTitle>Users - HellArch Admin</PageTitle>

@if (UserId is null)
{
    <h1>Users</h1>

    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr @onclick="() => ViewUser(user.Id)" class="clickable">
                        <td class="monospace">@user.Id[..8]...</td>
                        <td>@user.Email</td>
                        <td>@user.Username</td>
                        <td>
                            <span class="badge @(user.IsActive ? "badge-success" : "badge-danger")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <button disabled="@(_page <= 1)" @onclick="PrevPage" class="btn">Previous</button>
        <span>Page @_page of @_totalPages</span>
        <button disabled="@(_page >= _totalPages)" @onclick="NextPage" class="btn">Next</button>
    </div>
}
else
{
    <div class="breadcrumb">
        <a href="users">Users</a>
        <span>/</span>
        <span>@_userDetail?.Username</span>
    </div>

    <h1>User Details</h1>

    @if (_userDetail is not null)
    {
        <section class="detail-section">
            <h2>Profile</h2>
            <dl class="detail-list">
                <dt>ID</dt>
                <dd class="monospace">@_userDetail.Id</dd>
                <dt>Email</dt>
                <dd>@_userDetail.Email</dd>
                <dt>Username</dt>
                <dd>@_userDetail.Username</dd>
                <dt>Status</dt>
                <dd>
                    <span class="badge @(_userDetail.IsActive ? "badge-success" : "badge-danger")">
                        @(_userDetail.IsActive ? "Active" : "Inactive")
                    </span>
                    @if (_userDetail.IsActive)
                    {
                        <button @onclick="DeactivateUser" class="btn btn-danger btn-sm" style="margin-left: 0.5rem;">
                            Deactivate
                        </button>
                    }
                    else
                    {
                        <button @onclick="ActivateUser" class="btn btn-primary btn-sm" style="margin-left: 0.5rem;">
                            Activate
                        </button>
                    }
                </dd>
                <dt>Created</dt>
                <dd>@_userDetail.CreatedAt.ToString("F")</dd>
                <dt>Updated</dt>
                <dd>@_userDetail.UpdatedAt.ToString("F")</dd>
            </dl>
        </section>

        <section class="detail-section">
            <h2>Permissions</h2>
            <div class="permissions-container">
                @if (_userDetail.Permissions is not null && _userDetail.Permissions.Count > 0)
                {
                    <div class="permissions-list">
                        @foreach (var perm in _userDetail.Permissions.Where(p => p.Value))
                        {
                            <div class="permission-item">
                                <span class="permission-key">@perm.Key</span>
                                <button @onclick="() => RemovePermission(perm.Key)" class="btn btn-danger btn-sm">
                                    Remove
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-state">No permissions assigned</p>
                }

                <div class="add-permission">
                    <input type="text" @bind="_newPermission" @bind:event="oninput"
                           placeholder="e.g. admin.users.write" class="input" />
                    <button @onclick="AddPermission" disabled="@string.IsNullOrWhiteSpace(_newPermission)"
                            class="btn btn-primary">
                        Grant Permission
                    </button>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <h2>Linked Accounts (@_userDetail.LinkedAccounts.Count)</h2>
            @if (_userDetail.LinkedAccounts.Count > 0)
            {
                <div class="cards-grid">
                    @foreach (var account in _userDetail.LinkedAccounts)
                    {
                        <div class="card">
                            <div class="card-header">
                                <span class="provider-badge @account.Provider.ToLower()">@account.Provider</span>
                            </div>
                            <dl class="card-details">
                                <dt>Provider ID</dt>
                                <dd class="monospace">@account.ProviderUserId</dd>
                                @if (account.Email is not null)
                                {
                                    <dt>Email</dt>
                                    <dd>@account.Email</dd>
                                }
                                @if (account.Username is not null)
                                {
                                    <dt>Username</dt>
                                    <dd>@account.Username</dd>
                                }
                            </dl>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="empty-state">No linked accounts</p>
            }
        </section>

        <section class="detail-section">
            <h2>Sessions (@_sessions.Count)</h2>
            @if (_sessions.Count > 0)
            {
                <div class="data-table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>IP Address</th>
                                <th>User Agent</th>
                                <th>Expires</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in _sessions)
                            {
                                <tr>
                                    <td class="monospace">@session.Id[..8]...</td>
                                    <td>@(session.IpAddress ?? "Unknown")</td>
                                    <td class="truncate">@(session.UserAgent ?? "Unknown")</td>
                                    <td>@session.ExpiresAt.ToString("g")</td>
                                    <td>
                                        <button @onclick="() => RevokeSession(session.Id)" class="btn btn-danger btn-sm">
                                            Revoke
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="empty-state">No active sessions</p>
            }
        </section>
    }
    else
    {
        <p class="loading">Loading...</p>
    }
}

@code {
    [Parameter]
    public string? UserId { get; set; }

    private IReadOnlyList<UserSummary> _users = [];
    private UserDetail? _userDetail;
    private IReadOnlyList<SessionInfo> _sessions = [];
    private int _page = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;
    private string _newPermission = "";

    protected override async Task OnParametersSetAsync()
    {
        if (UserId is null)
        {
            await LoadUsers();
        }
        else
        {
            await LoadUserDetail();
        }
    }

    private async Task LoadUsers()
    {
        var response = await AuthAdmin.GetUsers(_page, PageSize);
        _users = response.Users;
        _totalPages = (int)Math.Ceiling(response.TotalCount / (double)PageSize);
    }

    private async Task LoadUserDetail()
    {
        if (UserId is null) return;

        _userDetail = await AuthAdmin.GetUser(UserId);
        _sessions = await AuthAdmin.GetUserSessions(UserId);
    }

    private void ViewUser(string userId)
    {
        Navigation.NavigateTo($"users/{userId}");
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadUsers();
        }
    }

    private async Task NextPage()
    {
        if (_page < _totalPages)
        {
            _page++;
            await LoadUsers();
        }
    }

    private async Task RevokeSession(string sessionId)
    {
        var success = await AuthAdmin.RevokeSession(sessionId);
        if (success && UserId is not null)
        {
            await LoadUserDetail();
        }
    }

    private async Task AddPermission()
    {
        if (string.IsNullOrWhiteSpace(_newPermission) || UserId is null) return;

        var success = await AuthAdmin.GrantPermission(UserId, _newPermission.Trim());
        if (success)
        {
            _newPermission = "";
            await LoadUserDetail();
        }
    }

    private async Task RemovePermission(string permission)
    {
        if (UserId is null) return;

        var success = await AuthAdmin.RevokePermission(UserId, permission);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    private async Task ActivateUser()
    {
        if (UserId is null) return;

        var success = await AuthAdmin.ActivateUser(UserId);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    private async Task DeactivateUser()
    {
        if (UserId is null) return;

        var success = await AuthAdmin.DeactivateUser(UserId);
        if (success)
        {
            await LoadUserDetail();
        }
    }
}
