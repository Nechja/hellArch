@page "/users"
@page "/users/{UserId}"
@using Admin.Services
@implements IDisposable
@inject AuthAdminFacade AuthAdmin
@inject NavigationManager Navigation
@inject LiveUpdateService LiveUpdate

<PageTitle>Users - HellArch Admin</PageTitle>

@if (UserId is null)
{
    <PageHeader Title="Users" />

    <MudTable Items="@_users" Hover="true" Striped="true" Dense="true" OnRowClick="@(args => ViewUser(args.Item?.Id ?? ""))" T="UserSummary" Class="mb-4">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Username</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID"><MonoText>@context.Id[..8]...</MonoText></MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Username">@context.Username</MudTd>
            <MudTd DataLabel="Status">
                <StatusChip Label="@(context.IsActive ? "Active" : "Inactive")"
                           Status="@(context.IsActive ? StatusChip.StatusType.Active : StatusChip.StatusType.Inactive)" />
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("g")</MudTd>
        </RowTemplate>
    </MudTable>

    <div class="d-flex justify-center align-center gap-4 mt-4">
        <MudButton Variant="Variant.Outlined" Disabled="@(_page <= 1)" OnClick="PrevPage">Previous</MudButton>
        <MudText>Page @_page of @_totalPages</MudText>
        <MudButton Variant="Variant.Outlined" Disabled="@(_page >= _totalPages)" OnClick="NextPage">Next</MudButton>
    </div>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <PageHeader Title="User Details" />

    @if (_userDetail is not null)
    {
        <MudText Typo="Typo.h6" Class="mb-4">Profile</MudText>
        <MudPaper Class="pa-4 mb-6" Elevation="2">
            <MudSimpleTable Dense="true" Hover="false">
                <tbody>
                    <tr>
                        <td style="width: 150px;"><MudText Typo="Typo.caption">ID</MudText></td>
                        <td><MonoText WordBreak="true">@_userDetail.Id</MonoText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Email</MudText></td>
                        <td>@_userDetail.Email</td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Username</MudText></td>
                        <td>@_userDetail.Username</td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Status</MudText></td>
                        <td>
                            <div class="d-flex align-center gap-2">
                                <StatusChip Label="@(_userDetail.IsActive ? "Active" : "Inactive")"
                                           Status="@(_userDetail.IsActive ? StatusChip.StatusType.Active : StatusChip.StatusType.Inactive)" />
                                @if (_userDetail.IsActive)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="DeactivateUser">Deactivate</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="ActivateUser">Activate</MudButton>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Created</MudText></td>
                        <td>@_userDetail.CreatedAt.ToString("F")</td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Updated</MudText></td>
                        <td>@_userDetail.UpdatedAt.ToString("F")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudPaper>

        <MudText Typo="Typo.h6" Class="mb-4">Permissions</MudText>
        <MudPaper Class="pa-4 mb-6" Elevation="2">
            @if (_userDetail.Permissions is not null && _userDetail.Permissions.Any(p => p.Value))
            {
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var perm in _userDetail.Permissions.Where(p => p.Value))
                    {
                        <MudChip T="string" Color="Color.Primary" OnClose="() => RemovePermission(perm.Key)">
                            @perm.Key
                        </MudChip>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No permissions assigned</MudText>
            }

            <MudDivider Class="my-4" />
            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_newPermission" Label="Permission" Placeholder="e.g. admin.users.write" Variant="Variant.Outlined" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddPermission" Disabled="@string.IsNullOrWhiteSpace(_newPermission)">
                    Grant
                </MudButton>
            </div>
        </MudPaper>

        <MudText Typo="Typo.h6" Class="mb-4">Linked Accounts (@_userDetail.LinkedAccounts.Count)</MudText>
        @if (_userDetail.LinkedAccounts.Count > 0)
        {
            <MudGrid Class="mb-6">
                @foreach (var account in _userDetail.LinkedAccounts)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mb-3">@account.Provider.ToUpperInvariant()</MudChip>
                            <MudSimpleTable Dense="true" Hover="false">
                                <tbody>
                                    <tr>
                                        <td><MudText Typo="Typo.caption">Provider ID</MudText></td>
                                        <td><MonoText>@account.ProviderUserId</MonoText></td>
                                    </tr>
                                    @if (account.Email is not null)
                                    {
                                        <tr>
                                            <td><MudText Typo="Typo.caption">Email</MudText></td>
                                            <td>@account.Email</td>
                                        </tr>
                                    }
                                    @if (account.Username is not null)
                                    {
                                        <tr>
                                            <td><MudText Typo="Typo.caption">Username</MudText></td>
                                            <td>@account.Username</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">No linked accounts</MudText>
        }

        <MudText Typo="Typo.h6" Class="mb-4">Sessions (@_sessions.Count)</MudText>
        @if (_sessions.Count > 0)
        {
            <MudTable Items="@_sessions" Hover="true" Striped="true" Dense="true" T="SessionInfo">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>IP Address</MudTh>
                    <MudTh>User Agent</MudTh>
                    <MudTh>Expires</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MonoText>@context.Id[..8]...</MonoText></MudTd>
                    <MudTd>@(context.IpAddress ?? "Unknown")</MudTd>
                    <MudTd Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(context.UserAgent ?? "Unknown")</MudTd>
                    <MudTd>@context.ExpiresAt.ToString("g")</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => RevokeSession(context.Id)">Revoke</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No active sessions</MudText>
        }
    }
    else
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
}

@code {
    [Parameter]
    public string? UserId { get; set; }

    private IReadOnlyList<UserSummary> _users = [];
    private UserDetail? _userDetail;
    private IReadOnlyList<SessionInfo> _sessions = [];
    private int _page = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;
    private string _newPermission = "";
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnInitialized()
    {
        LiveUpdate.OnUserUpdate += HandleUserUpdate;
        LiveUpdate.OnSessionUpdate += HandleSessionUpdate;
    }

    protected override async Task OnParametersSetAsync()
    {
        _breadcrumbs =
        [
            new("Users", href: "users"),
            new(_userDetail?.Username ?? UserId ?? "", href: null, disabled: true)
        ];

        if (UserId is null)
        {
            await LoadUsers();
        }
        else
        {
            await LoadUserDetail();
        }
    }

    private void HandleUserUpdate(object? sender, UpdateEventArgs e)
    {
        InvokeAsync(async () =>
        {
            if (UserId is null)
            {
                await LoadUsers();
            }
            else
            {
                await LoadUserDetail();
            }
            StateHasChanged();
        });
    }

    private void HandleSessionUpdate(object? sender, UpdateEventArgs e)
    {
        InvokeAsync(async () =>
        {
            if (UserId is not null)
            {
                _sessions = await AuthAdmin.GetUserSessions(UserId);
                StateHasChanged();
            }
        });
    }

    private async Task LoadUsers()
    {
        var response = await AuthAdmin.GetUsers(_page, PageSize);
        _users = response.Users;
        _totalPages = (int)Math.Ceiling(response.TotalCount / (double)PageSize);
    }

    private async Task LoadUserDetail()
    {
        if (UserId is null) return;

        _userDetail = await AuthAdmin.GetUser(UserId);
        _sessions = await AuthAdmin.GetUserSessions(UserId);
    }

    private void ViewUser(string userId)
    {
        Navigation.NavigateTo($"users/{userId}");
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadUsers();
        }
    }

    private async Task NextPage()
    {
        if (_page < _totalPages)
        {
            _page++;
            await LoadUsers();
        }
    }

    private async Task RevokeSession(string sessionId)
    {
        var success = await AuthAdmin.RevokeSession(sessionId);
        if (success && UserId is not null)
        {
            await LoadUserDetail();
        }
    }

    private async Task AddPermission()
    {
        if (string.IsNullOrWhiteSpace(_newPermission) || UserId is null) return;

        var success = await AuthAdmin.GrantPermission(UserId, _newPermission.Trim());
        if (success)
        {
            _newPermission = "";
            await LoadUserDetail();
        }
    }

    private async Task RemovePermission(string permission)
    {
        if (UserId is null) return;

        var success = await AuthAdmin.RevokePermission(UserId, permission);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    private async Task ActivateUser()
    {
        if (UserId is null) return;

        var success = await AuthAdmin.ActivateUser(UserId);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    private async Task DeactivateUser()
    {
        if (UserId is null) return;

        var success = await AuthAdmin.DeactivateUser(UserId);
        if (success)
        {
            await LoadUserDetail();
        }
    }

    public void Dispose()
    {
        LiveUpdate.OnUserUpdate -= HandleUserUpdate;
        LiveUpdate.OnSessionUpdate -= HandleSessionUpdate;
    }
}
