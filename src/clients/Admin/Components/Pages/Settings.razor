@page "/settings"
@using Admin.Services
@implements IDisposable
@inject LiveUpdateService LiveUpdate
@inject RealtimeHubService RealtimeHub
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Settings - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-8">Settings</h1>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Account -->
    <div class="card">
        <h2 class="text-heading mb-4">Account</h2>
        <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-neon-pink to-neon-orange flex-center text-2xl font-bold text-white">
                @_initials
            </div>
            <div>
                <p class="text-lg font-semibold">@_username</p>
                <p class="text-text-muted text-sm">Administrator</p>
            </div>
        </div>
        <a href="/api/auth/logout" class="btn-danger w-full text-center">Sign Out</a>
    </div>

    <!-- Connection Status -->
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-heading">Live Connection</h2>
            <Badge Variant="@GetConnectionBadge()">@RealtimeHub.ConnectionStateText</Badge>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div class="p-4 rounded-sm bg-surface-raised text-center">
                <p class="text-3xl font-bold text-primary tabular-nums">@_eventsReceived</p>
                <p class="text-xs text-text-muted uppercase tracking-wide mt-1">Events Received</p>
            </div>
            <div class="p-4 rounded-sm bg-surface-raised text-center">
                <p class="text-3xl font-bold text-text tabular-nums">@_lastEventTime</p>
                <p class="text-xs text-text-muted uppercase tracking-wide mt-1">Last Event</p>
            </div>
        </div>
    </div>

    <!-- Notifications -->
    <div class="card lg:col-span-2">
        <h2 class="text-heading mb-4">Notifications</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <label class="flex items-center justify-between p-4 rounded-sm bg-surface-raised cursor-pointer hover:bg-surface-elevated transition-colors">
                <div>
                    <p class="font-medium">User Events</p>
                    <p class="text-xs text-text-muted">Created, updated, deleted</p>
                </div>
                <Toggle @bind-Value="_notifyUsers" />
            </label>
            <label class="flex items-center justify-between p-4 rounded-sm bg-surface-raised cursor-pointer hover:bg-surface-elevated transition-colors">
                <div>
                    <p class="font-medium">Sessions</p>
                    <p class="text-xs text-text-muted">Login, logout</p>
                </div>
                <Toggle @bind-Value="_notifySessions" />
            </label>
            <label class="flex items-center justify-between p-4 rounded-sm bg-surface-raised cursor-pointer hover:bg-surface-elevated transition-colors">
                <div>
                    <p class="font-medium">Health</p>
                    <p class="text-xs text-text-muted">Service status changes</p>
                </div>
                <Toggle @bind-Value="_notifyHealth" />
            </label>
            <label class="flex items-center justify-between p-4 rounded-sm bg-surface-raised cursor-pointer hover:bg-surface-elevated transition-colors">
                <div>
                    <p class="font-medium">Webhooks</p>
                    <p class="text-xs text-text-muted">Delivery failures</p>
                </div>
                <Toggle @bind-Value="_notifyWebhooks" />
            </label>
        </div>
    </div>
</div>

<div class="mt-8 text-center text-text-muted text-sm">
    <p>HellArch Admin &bull; Blazor Server &bull; .NET @Environment.Version.ToString(2)</p>
</div>

@code {
    private string _username = "";
    private string _initials = "";
    private int _eventsReceived;
    private string _lastEventTime = "--:--";

    private bool _notifyUsers = true;
    private bool _notifySessions = true;
    private bool _notifyHealth = true;
    private bool _notifyWebhooks = true;

    protected override void OnInitialized()
    {
        _username = HttpContextAccessor.HttpContext?.Items["Username"]?.ToString() ?? "Admin";
        _initials = GetInitials(_username);

        LiveUpdate.OnAnyEvent += HandleEvent;
    }

    private void HandleEvent(object? sender, CloudEventUpdateEventArgs e)
    {
        _eventsReceived++;
        _lastEventTime = DateTime.Now.ToString("HH:mm:ss");
        InvokeAsync(StateHasChanged);
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        }

        return name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    private BadgeVariant GetConnectionBadge() => RealtimeHub.ConnectionStateText switch
    {
        "Connected" => BadgeVariant.Success,
        "Reconnecting" => BadgeVariant.Warning,
        _ => BadgeVariant.Danger
    };

    public void Dispose()
    {
        LiveUpdate.OnAnyEvent -= HandleEvent;
    }
}
