@page "/settings"
@inject ISnackbar Snackbar

<PageTitle>Settings - HellArch Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    System Configuration
</MudText>

@*
TODO: Rebuild this page with MudBlazor
Original functionality:
- 4 configuration sections in 2x2 grid:

1. Sessions:
   - Session Timeout (minutes): number input, 5-1440
   - Max Concurrent Sessions: number input, 1-10
   - Revoke on Password Change: toggle

2. Webhooks:
   - Max Retry Attempts: number input, 0-10
   - Retry Interval (seconds): number input, 5-3600
   - Request Timeout (seconds): number input, 5-60

3. Rate Limiting:
   - Requests per Minute: number input, 10-1000
   - Burst Limit: number input, 5-100
   - Enable Rate Limiting: toggle

4. Events:
   - Retention Period (days): number input, 1-365
   - Max Payload Size (KB): number input, 1-1024
   - Archive on Delete: toggle

- Footer buttons: Reset to Defaults, Save Changes
- Note: SaveSettings() and ResetToDefaults() were stubbed (TODO: Persist to configuration store)
*@

<MudAlert Severity="Severity.Info" Class="mb-6">
    This page is being rebuilt with MudBlazor. See source comments for original functionality.
</MudAlert>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Sessions</MudText>
            <MudNumericField @bind-Value="_sessionTimeout" Label="Session Timeout (minutes)" Min="5" Max="1440" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField @bind-Value="_maxConcurrentSessions" Label="Max Concurrent Sessions" Min="1" Max="10" Variant="Variant.Outlined" Class="mb-4" />
            <MudSwitch @bind-Value="_revokeOnPasswordChange" Label="Revoke on Password Change" Color="Color.Primary" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Webhooks</MudText>
            <MudNumericField @bind-Value="_webhookMaxRetries" Label="Max Retry Attempts" Min="0" Max="10" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField @bind-Value="_webhookRetryInterval" Label="Retry Interval (seconds)" Min="5" Max="3600" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField @bind-Value="_webhookTimeout" Label="Request Timeout (seconds)" Min="5" Max="60" Variant="Variant.Outlined" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Rate Limiting</MudText>
            <MudNumericField @bind-Value="_rateLimit" Label="Requests per Minute" Min="10" Max="1000" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField @bind-Value="_burstLimit" Label="Burst Limit" Min="5" Max="100" Variant="Variant.Outlined" Class="mb-4" />
            <MudSwitch @bind-Value="_rateLimitEnabled" Label="Enable Rate Limiting" Color="Color.Primary" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Events</MudText>
            <MudNumericField @bind-Value="_eventRetentionDays" Label="Retention Period (days)" Min="1" Max="365" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField @bind-Value="_maxPayloadSize" Label="Max Payload Size (KB)" Min="1" Max="1024" Variant="Variant.Outlined" Class="mb-4" />
            <MudSwitch @bind-Value="_archiveOnDelete" Label="Archive on Delete" Color="Color.Primary" />
        </MudPaper>
    </MudItem>
</MudGrid>

<div class="d-flex justify-end gap-2 mt-6">
    <MudButton Variant="Variant.Outlined" OnClick="ResetToDefaults">Reset to Defaults</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings">Save Changes</MudButton>
</div>

@code {
    private int _sessionTimeout = 30;
    private int _maxConcurrentSessions = 3;
    private bool _revokeOnPasswordChange = true;

    private int _webhookMaxRetries = 3;
    private int _webhookRetryInterval = 60;
    private int _webhookTimeout = 30;

    private int _rateLimit = 100;
    private int _burstLimit = 20;
    private bool _rateLimitEnabled = true;

    private int _eventRetentionDays = 30;
    private int _maxPayloadSize = 256;
    private bool _archiveOnDelete;

    private void SaveSettings()
    {
        // TODO: Persist to configuration store
        Snackbar.Add("Settings saved (not persisted - TODO)", Severity.Success);
    }

    private void ResetToDefaults()
    {
        _sessionTimeout = 30;
        _maxConcurrentSessions = 3;
        _revokeOnPasswordChange = true;
        _webhookMaxRetries = 3;
        _webhookRetryInterval = 60;
        _webhookTimeout = 30;
        _rateLimit = 100;
        _burstLimit = 20;
        _rateLimitEnabled = true;
        _eventRetentionDays = 30;
        _maxPayloadSize = 256;
        _archiveOnDelete = false;
        Snackbar.Add("Settings reset to defaults", Severity.Info);
    }
}
