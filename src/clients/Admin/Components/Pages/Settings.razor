@page "/settings"
@using Admin.Services
@implements IDisposable
@inject IConfiguration Configuration
@inject LiveUpdateService LiveUpdate
@inject RealtimeHubService RealtimeHub
@inject NavigationManager Navigation

<PageTitle>Settings - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-8">Settings</h1>

<div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8">
    <!-- Sidebar Navigation -->
    <nav class="lg:sticky lg:top-6 lg:self-start">
        <div class="card p-0 overflow-hidden">
            @foreach (var navItem in _sections)
            {
                <button type="button"
                        class="w-full text-left px-4 py-3 border-b border-border last:border-0 transition-colors @(navItem.Id == _activeSection ? "bg-surface-elevated text-primary border-l-2 border-l-primary" : "text-text-secondary hover:bg-surface-elevated hover:text-text")"
                        @onclick="() => ScrollToSection(navItem.Id)">
                    <span class="flex items-center gap-3">
                        <span class="text-lg">@navItem.Icon</span>
                        <span class="font-medium">@navItem.Title</span>
                    </span>
                </button>
            }
        </div>
    </nav>

    <!-- Settings Content -->
    <div class="stack-lg">
        <!-- Live Updates Section -->
        <section id="live-updates" class="card">
            <div class="flex items-center gap-3 mb-6">
                <div class="icon-box-pink">
                    <span class="text-xl">&#9889;</span>
                </div>
                <div>
                    <h2 class="text-heading">Live Updates</h2>
                    <p class="text-caption">Configure real-time data refresh settings</p>
                </div>
            </div>

            <div class="stack">
                <SettingsRow Label="Enable Live Updates" Description="Automatically refresh data when events are received">
                    <Toggle @bind-Value="_liveUpdatesEnabled" />
                </SettingsRow>

                <SettingsRow Label="Health Check Interval" Description="How often to poll for service health status">
                    <select @bind="_healthInterval" class="input w-40">
                        <option value="10">10 seconds</option>
                        <option value="15">15 seconds</option>
                        <option value="30">30 seconds</option>
                        <option value="60">1 minute</option>
                    </select>
                </SettingsRow>

                <SettingsRow Label="Stats Refresh Interval" Description="How often to refresh dashboard statistics">
                    <select @bind="_statsInterval" class="input w-40">
                        <option value="15">15 seconds</option>
                        <option value="30">30 seconds</option>
                        <option value="60">1 minute</option>
                        <option value="120">2 minutes</option>
                    </select>
                </SettingsRow>
            </div>
        </section>

        <!-- Notifications Section -->
        <section id="notifications" class="card">
            <div class="flex items-center gap-3 mb-6">
                <div class="icon-box-coral">
                    <span class="text-xl">&#128276;</span>
                </div>
                <div>
                    <h2 class="text-heading">Notifications</h2>
                    <p class="text-caption">Control toast notifications and alerts</p>
                </div>
            </div>

            <div class="stack">
                <SettingsRow Label="Show Toast Notifications" Description="Display pop-up notifications for important events">
                    <Toggle @bind-Value="_toastsEnabled" />
                </SettingsRow>

                <SettingsRow Label="User Events" Description="Notify when users are created, updated, or deleted">
                    <Toggle @bind-Value="_notifyUserEvents" />
                </SettingsRow>

                <SettingsRow Label="Session Events" Description="Notify when sessions are created or ended">
                    <Toggle @bind-Value="_notifySessionEvents" />
                </SettingsRow>

                <SettingsRow Label="Health Alerts" Description="Notify when services become unhealthy or recover">
                    <Toggle @bind-Value="_notifyHealthEvents" />
                </SettingsRow>

                <SettingsRow Label="Webhook Events" Description="Notify on webhook deliveries and failures">
                    <Toggle @bind-Value="_notifyWebhookEvents" />
                </SettingsRow>
            </div>
        </section>

        <!-- Connection Section -->
        <section id="connection" class="card">
            <div class="flex items-center gap-3 mb-6">
                <div class="icon-box-green">
                    <span class="text-xl">&#128279;</span>
                </div>
                <div>
                    <h2 class="text-heading">Connection</h2>
                    <p class="text-caption">Real-time connection status and controls</p>
                </div>
            </div>

            <div class="stack">
                <div class="flex items-center justify-between py-3 border-b border-border">
                    <div>
                        <p class="font-medium">SignalR Connection</p>
                        <p class="text-caption">Real-time event streaming</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <Badge Variant="@GetConnectionBadgeVariant()">@RealtimeHub.ConnectionStateText</Badge>
                    </div>
                </div>

                <KeyValue>
                    <KeyValueItem Key="Hub URL" Value="@_hubUrl" />
                    <KeyValueItem Key="Last Event" Value="@_lastEventTime" />
                    <KeyValueItem Key="Events Received" Value="@_eventsReceived.ToString()" />
                </KeyValue>
            </div>
        </section>

        <!-- System Information Section -->
        <section id="system" class="card">
            <div class="flex items-center gap-3 mb-6">
                <div class="icon-box-peach">
                    <span class="text-xl">&#9881;</span>
                </div>
                <div>
                    <h2 class="text-heading">System Information</h2>
                    <p class="text-caption">Environment and service configuration</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-subheading mb-3 text-glitch">Environment</h3>
                    <KeyValue>
                        <KeyValueItem Key="Environment" Value="@_environment" />
                        <KeyValueItem Key="Log Level" Value="@_logLevel" />
                        <KeyValueItem Key=".NET Version" Value="@_dotnetVersion" />
                    </KeyValue>
                </div>

                <div>
                    <h3 class="text-subheading mb-3 text-glitch">Service URLs</h3>
                    <KeyValue>
                        <KeyValueItem Key="Gateway" Value="@_gatewayUrl" />
                        <KeyValueItem Key="Health" Value="@_healthUrl" />
                        <KeyValueItem Key="Redis" Value="@_redisUrl" />
                    </KeyValue>
                </div>
            </div>
        </section>

        <!-- Quick Links Section -->
        <section id="links" class="card">
            <div class="flex items-center gap-3 mb-6">
                <div class="icon-box-rose">
                    <span class="text-xl">&#128279;</span>
                </div>
                <div>
                    <h2 class="text-heading">Quick Links</h2>
                    <p class="text-caption">External tools and documentation</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <a href="http://localhost:16686" target="_blank" rel="noopener" class="card-interactive flex items-center gap-3">
                    <div class="icon-box-pink">
                        <span>&#128269;</span>
                    </div>
                    <div>
                        <p class="font-medium text-neon-pink">Jaeger</p>
                        <p class="text-xs text-text-muted">Distributed Tracing</p>
                    </div>
                </a>

                <a href="http://localhost:15672" target="_blank" rel="noopener" class="card-interactive flex items-center gap-3">
                    <div class="icon-box-orange">
                        <span>&#128236;</span>
                    </div>
                    <div>
                        <p class="font-medium text-neon-orange">RabbitMQ</p>
                        <p class="text-xs text-text-muted">Message Queue</p>
                    </div>
                </a>

                <a href="http://localhost:5004/status" target="_blank" rel="noopener" class="card-interactive flex items-center gap-3">
                    <div class="icon-box-green">
                        <span>&#128155;</span>
                    </div>
                    <div>
                        <p class="font-medium text-neon-green">Health API</p>
                        <p class="text-xs text-text-muted">Status JSON</p>
                    </div>
                </a>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="card">
            <div class="flex items-center gap-3 mb-6">
                <div class="icon-box-dusty">
                    <span class="text-xl">&#9432;</span>
                </div>
                <div>
                    <h2 class="text-heading">About</h2>
                    <p class="text-caption">Application information</p>
                </div>
            </div>

            <div class="flex items-start gap-6">
                <div class="flex-1">
                    <KeyValue>
                        <KeyValueItem Key="Application" Value="HellArch Admin Console" />
                        <KeyValueItem Key="Version" Value="1.0.0" />
                        <KeyValueItem Key="Framework" Value="Blazor Server (.NET 10)" />
                        <KeyValueItem Key="UI Library" Value="UnoCSS + Custom Components" />
                    </KeyValue>
                </div>
                <div class="text-right">
                    <p class="text-6xl mb-2">&#128293;</p>
                    <p class="text-gradient font-bold">HellArch</p>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private record SettingsSection(string Id, string Title, string Icon);

    private readonly SettingsSection[] _sections =
    [
        new("live-updates", "Live Updates", "&#9889;"),
        new("notifications", "Notifications", "&#128276;"),
        new("connection", "Connection", "&#128279;"),
        new("system", "System", "&#9881;"),
        new("links", "Quick Links", "&#128279;"),
        new("about", "About", "&#9432;")
    ];

    private string _activeSection = "live-updates";

    // Live Updates settings
    private bool _liveUpdatesEnabled = true;
    private int _healthInterval = 15;
    private int _statsInterval = 30;

    // Notification settings
    private bool _toastsEnabled = true;
    private bool _notifyUserEvents = true;
    private bool _notifySessionEvents = true;
    private bool _notifyHealthEvents = true;
    private bool _notifyWebhookEvents = true;

    // Connection info
    private string _hubUrl = "";
    private string _lastEventTime = "Never";
    private int _eventsReceived;

    // System info
    private string _environment = "";
    private string _logLevel = "";
    private string _dotnetVersion = "";
    private string _gatewayUrl = "";
    private string _healthUrl = "";
    private string _redisUrl = "";

    protected override void OnInitialized()
    {
        // Load system info from configuration
        _environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";
        _logLevel = Environment.GetEnvironmentVariable("LOG_LEVEL") ?? "Debug";
        _dotnetVersion = Environment.Version.ToString();
        _gatewayUrl = Environment.GetEnvironmentVariable("GATEWAY_URL") ?? "http://localhost:5000";
        _healthUrl = Environment.GetEnvironmentVariable("HEALTH_SERVICE_URL") ?? "http://health:5004";
        _redisUrl = Environment.GetEnvironmentVariable("REDIS_URL") ?? "localhost:6379";
        _hubUrl = $"{_gatewayUrl}/hubs/events";

        // Subscribe to events for counting
        LiveUpdate.OnAnyEvent += HandleAnyEvent;
    }

    private void HandleAnyEvent(object? sender, CloudEventUpdateEventArgs e)
    {
        _eventsReceived++;
        _lastEventTime = DateTime.Now.ToString("HH:mm:ss");
        InvokeAsync(StateHasChanged);
    }

    private void ScrollToSection(string sectionId)
    {
        _activeSection = sectionId;
        Navigation.NavigateTo($"/settings#{sectionId}", forceLoad: false);
    }

    private BadgeVariant GetConnectionBadgeVariant() => RealtimeHub.ConnectionStateText switch
    {
        "Connected" => BadgeVariant.Success,
        "Reconnecting" => BadgeVariant.Warning,
        _ => BadgeVariant.Danger
    };

    public void Dispose()
    {
        LiveUpdate.OnAnyEvent -= HandleAnyEvent;
    }
}
