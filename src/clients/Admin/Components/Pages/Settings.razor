@page "/settings"

<PageTitle>Settings - HellArch Admin</PageTitle>

<h1 class="text-display text-gradient mb-8">System Configuration</h1>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Session Configuration -->
    <div class="card">
        <h2 class="text-heading mb-4">Sessions</h2>
        <div class="space-y-4">
            <div>
                <label class="text-sm text-text-muted mb-1 block">Session Timeout (minutes)</label>
                <input type="number" class="input w-full" @bind="_sessionTimeout" min="5" max="1440" />
            </div>
            <div>
                <label class="text-sm text-text-muted mb-1 block">Max Concurrent Sessions</label>
                <input type="number" class="input w-full" @bind="_maxConcurrentSessions" min="1" max="10" />
            </div>
            <label class="flex items-center justify-between p-3 rounded-sm bg-surface-raised">
                <span class="text-sm">Revoke on Password Change</span>
                <Toggle @bind-Value="_revokeOnPasswordChange" />
            </label>
        </div>
    </div>

    <!-- Webhook Configuration -->
    <div class="card">
        <h2 class="text-heading mb-4">Webhooks</h2>
        <div class="space-y-4">
            <div>
                <label class="text-sm text-text-muted mb-1 block">Max Retry Attempts</label>
                <input type="number" class="input w-full" @bind="_webhookMaxRetries" min="0" max="10" />
            </div>
            <div>
                <label class="text-sm text-text-muted mb-1 block">Retry Interval (seconds)</label>
                <input type="number" class="input w-full" @bind="_webhookRetryInterval" min="5" max="3600" />
            </div>
            <div>
                <label class="text-sm text-text-muted mb-1 block">Request Timeout (seconds)</label>
                <input type="number" class="input w-full" @bind="_webhookTimeout" min="5" max="60" />
            </div>
        </div>
    </div>

    <!-- Rate Limiting -->
    <div class="card">
        <h2 class="text-heading mb-4">Rate Limiting</h2>
        <div class="space-y-4">
            <div>
                <label class="text-sm text-text-muted mb-1 block">Requests per Minute</label>
                <input type="number" class="input w-full" @bind="_rateLimit" min="10" max="1000" />
            </div>
            <div>
                <label class="text-sm text-text-muted mb-1 block">Burst Limit</label>
                <input type="number" class="input w-full" @bind="_burstLimit" min="5" max="100" />
            </div>
            <label class="flex items-center justify-between p-3 rounded-sm bg-surface-raised">
                <span class="text-sm">Enable Rate Limiting</span>
                <Toggle @bind-Value="_rateLimitEnabled" />
            </label>
        </div>
    </div>

    <!-- Event Retention -->
    <div class="card">
        <h2 class="text-heading mb-4">Events</h2>
        <div class="space-y-4">
            <div>
                <label class="text-sm text-text-muted mb-1 block">Retention Period (days)</label>
                <input type="number" class="input w-full" @bind="_eventRetentionDays" min="1" max="365" />
            </div>
            <div>
                <label class="text-sm text-text-muted mb-1 block">Max Payload Size (KB)</label>
                <input type="number" class="input w-full" @bind="_maxPayloadSize" min="1" max="1024" />
            </div>
            <label class="flex items-center justify-between p-3 rounded-sm bg-surface-raised">
                <span class="text-sm">Archive on Delete</span>
                <Toggle @bind-Value="_archiveOnDelete" />
            </label>
        </div>
    </div>
</div>

<div class="mt-6 flex justify-end gap-3">
    <button class="btn-ghost" @onclick="ResetToDefaults">Reset to Defaults</button>
    <button class="btn-primary" @onclick="SaveSettings">Save Changes</button>
</div>

@code {
    private int _sessionTimeout = 30;
    private int _maxConcurrentSessions = 3;
    private bool _revokeOnPasswordChange = true;

    private int _webhookMaxRetries = 3;
    private int _webhookRetryInterval = 60;
    private int _webhookTimeout = 30;

    private int _rateLimit = 100;
    private int _burstLimit = 20;
    private bool _rateLimitEnabled = true;

    private int _eventRetentionDays = 30;
    private int _maxPayloadSize = 256;
    private bool _archiveOnDelete;

    private void SaveSettings()
    {
        // TODO: Persist to configuration store
    }

    private void ResetToDefaults()
    {
        _sessionTimeout = 30;
        _maxConcurrentSessions = 3;
        _revokeOnPasswordChange = true;

        _webhookMaxRetries = 3;
        _webhookRetryInterval = 60;
        _webhookTimeout = 30;

        _rateLimit = 100;
        _burstLimit = 20;
        _rateLimitEnabled = true;

        _eventRetentionDays = 30;
        _maxPayloadSize = 256;
        _archiveOnDelete = false;
    }
}
