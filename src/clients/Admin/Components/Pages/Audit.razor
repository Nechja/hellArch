@page "/audit"
@using HellArch.CloudEvents
@using Admin.Services
@implements IDisposable
@inject EventsAdminFacade EventsApi
@inject LiveUpdateService LiveUpdate
@inject ILogger<Audit> Logger

<PageTitle>Audit Logs - HellArch Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6" Style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    Audit Logs
</MudText>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    View system audit logs for all events processed by the platform.
</MudText>

@*
TODO: Rebuild this page with MudBlazor
Original functionality:
- Event Type Categories grid: Clickable buttons organized by category
  - Auth - Users: Created, Updated, Deleted
  - Auth - Sessions: Created, Ended
  - Auth - Accounts: Linked, Unlinked
  - Infrastructure: Unhealthy, Recovered
  - Clicking a button filters the table by that event type

- Filters section:
  - Event Type text input (e.g. hellarch.auth.user.created.v1)
  - Actor ID text input (User ID)
  - Filter/Clear buttons

- Audit Logs table: Time, Event Type (clickable badge), Source, Actor, Target, Details
  - Details column has "View" link that opens modal with full log info
  - Pagination: Previous/Next buttons, page number, total count

- Detail Modal shows:
  - ID, Event ID, Event Type badge, Source
  - Actor ID, Target ID, Created timestamp
  - Formatted JSON metadata
*@

<MudAlert Severity="Severity.Info" Class="mb-6">
    This page is being rebuilt with MudBlazor. See source comments for original functionality.
</MudAlert>

<MudGrid Class="mb-6">
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="_eventTypeFilter" Label="Event Type" Placeholder="e.g. hellarch.auth.user.created.v1" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="_actorIdFilter" Label="Actor ID" Placeholder="User ID" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="4" Class="d-flex align-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">Filter</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear</MudButton>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_auditLogs" Hover="true" Striped="true" Dense="true" T="Admin.Services.AuditLog" Class="mb-4">
        <HeaderContent>
            <MudTh>Time</MudTh>
            <MudTh>Event Type</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Actor</MudTh>
            <MudTh>Target</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClick="() => FilterByEventType(context.EventType)">
                    @GetShortEventType(context.EventType)
                </MudChip>
            </MudTd>
            <MudTd>@context.Source</MudTd>
            <MudTd Style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">@(context.ActorId ?? "-")</MudTd>
            <MudTd Style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">@(context.TargetId ?? "-")</MudTd>
        </RowTemplate>
    </MudTable>

    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Showing @_auditLogs.Count of @_totalCount logs
        </MudText>
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
            <MudButton Disabled="@(_page <= 1)" OnClick="PreviousPage">Previous</MudButton>
            <MudButton Disabled="true">Page @_page</MudButton>
            <MudButton Disabled="@(!HasMorePages)" OnClick="NextPage">Next</MudButton>
        </MudButtonGroup>
    </div>
}

@code {
    private IReadOnlyList<Admin.Services.AuditLog> _auditLogs = [];
    private int _totalCount;
    private int _page = 1;
    private const int PageSize = 20;
    private bool _loading = true;
    private string? _eventTypeFilter;
    private string? _actorIdFilter;

    private bool HasMorePages => _page * PageSize < _totalCount;

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnAnyEvent += HandleAnyEvent;
        await LoadData();
    }

    private void HandleAnyEvent(object? sender, CloudEventUpdateEventArgs e)
    {
        InvokeAsync(async () => await LoadData());
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        var response = await EventsApi.GetAuditLogs(_page, PageSize, _eventTypeFilter, _actorIdFilter);
        _auditLogs = response.Data;
        _totalCount = response.TotalCount;

        _loading = false;
        StateHasChanged();
    }

    private async Task FilterByEventType(string eventType)
    {
        _eventTypeFilter = eventType;
        _page = 1;
        await LoadData();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _eventTypeFilter = null;
        _actorIdFilter = null;
        _page = 1;
        await LoadData();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadData();
    }

    private async Task PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadData();
        }
    }

    private static string GetShortEventType(string eventType)
    {
        var parts = eventType.Split('.');
        return parts.Length >= 4 ? string.Join(".", parts[^3..]) : eventType;
    }

    public void Dispose()
    {
        LiveUpdate.OnAnyEvent -= HandleAnyEvent;
    }
}
