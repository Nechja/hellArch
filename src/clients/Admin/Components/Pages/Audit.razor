@page "/audit"
@using HellArch.CloudEvents
@using Admin.Services
@implements IDisposable
@inject EventsAdminFacade EventsApi
@inject LiveUpdateService LiveUpdate
@inject ILogger<Audit> Logger

<PageTitle>Audit Logs - HellArch Admin</PageTitle>

<PageHeader Title="Audit Logs" Subtitle="View system audit logs for all events processed by the platform." />

<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">Quick Filters</MudText>
<MudGrid Class="mb-6">
    @foreach (var category in EventCategories)
    {
        <MudItem xs="12" md="6" lg="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-2">@category.Name</MudText>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var evt in category.Events)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_eventTypeFilter == evt.Type ? Color.Primary : Color.Default)"
                                 OnClick="() => FilterByEventType(evt.Type)">@evt.Label</MudChip>
                    }
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudGrid Class="mb-6">
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="_eventTypeFilter" Label="Event Type" Placeholder="e.g. hellarch.auth.user.created.v1" Variant="Variant.Outlined" Immediate="true" />
    </MudItem>
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="_actorIdFilter" Label="Actor ID" Placeholder="User ID" Variant="Variant.Outlined" Immediate="true" />
    </MudItem>
    <MudItem xs="12" md="4" Class="d-flex align-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">Filter</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear</MudButton>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_auditLogs" Hover="true" Striped="true" Dense="true" T="Admin.Services.AuditLog" Class="mb-4">
        <HeaderContent>
            <MudTh>Time</MudTh>
            <MudTh>Event Type</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Actor</MudTh>
            <MudTh>Target</MudTh>
            <MudTh>Details</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MonoText FontSize="0.75rem">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MonoText></MudTd>
            <MudTd>
                <EventTypeChip EventType="@context.EventType" OnClick="FilterByEventType" />
            </MudTd>
            <MudTd>@context.Source</MudTd>
            <MudTd><MonoText FontSize="0.75rem">@(context.ActorId ?? "-")</MonoText></MudTd>
            <MudTd><MonoText FontSize="0.75rem">@(context.TargetId ?? "-")</MonoText></MudTd>
            <MudTd>
                @if (context.Metadata.HasValue)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => ShowDetails(context)">
                        View
                    </MudButton>
                }
                else
                {
                    <MudText Color="Color.Secondary">-</MudText>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount"
                DisplayedCount="_auditLogs.Count" OnPrevious="PreviousPage" OnNext="NextPage" />
}

<MudDialog @bind-Visible="_showDetails" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Audit Log Details</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedLog is not null)
        {
            <MudSimpleTable Dense="true" Hover="false" Class="mb-4">
                <tbody>
                    <tr>
                        <td style="width: 120px;"><MudText Typo="Typo.caption">ID</MudText></td>
                        <td><MonoText WordBreak="true">@_selectedLog.Id</MonoText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Event ID</MudText></td>
                        <td><MonoText WordBreak="true">@_selectedLog.EventId</MonoText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Event Type</MudText></td>
                        <td><EventTypeChip EventType="@_selectedLog.EventType" UseShortForm="false" /></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Source</MudText></td>
                        <td>@_selectedLog.Source</td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Actor ID</MudText></td>
                        <td><MonoText>@(_selectedLog.ActorId ?? "N/A")</MonoText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Target ID</MudText></td>
                        <td><MonoText>@(_selectedLog.TargetId ?? "N/A")</MonoText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">Created</MudText></td>
                        <td>@_selectedLog.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            @if (_selectedLog.Metadata.HasValue)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Metadata</MudText>
                <JsonViewer Json="@_selectedLog.Metadata.Value" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDetails">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<Admin.Services.AuditLog> _auditLogs = [];
    private int _totalCount;
    private int _page = 1;
    private const int PageSize = 20;
    private bool _loading = true;
    private string? _eventTypeFilter;
    private string? _actorIdFilter;
    private Admin.Services.AuditLog? _selectedLog;
    private bool _showDetails;


    private static readonly EventCategory[] EventCategories =
    [
        new("Auth - Users", [
            new("hellarch.auth.user.created.v1", "Created"),
            new("hellarch.auth.user.updated.v1", "Updated"),
            new("hellarch.auth.user.deleted.v1", "Deleted")
        ]),
        new("Auth - Sessions", [
            new("hellarch.auth.session.created.v1", "Created"),
            new("hellarch.auth.session.ended.v1", "Ended")
        ]),
        new("Auth - Accounts", [
            new("hellarch.auth.account.linked.v1", "Linked"),
            new("hellarch.auth.account.unlinked.v1", "Unlinked")
        ]),
        new("Infrastructure", [
            new("hellarch.infra.service.unhealthy.v1", "Unhealthy"),
            new("hellarch.infra.service.recovered.v1", "Recovered")
        ])
    ];

    private record EventCategory(string Name, EventTypeInfo[] Events);
    private record EventTypeInfo(string Type, string Label);

    protected override async Task OnInitializedAsync()
    {
        LiveUpdate.OnAnyEvent += HandleAnyEvent;
        await LoadData();
    }

    private void HandleAnyEvent(object? sender, CloudEventUpdateEventArgs e)
    {
        InvokeAsync(async () => await LoadData());
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        var response = await EventsApi.GetAuditLogs(_page, PageSize, _eventTypeFilter, _actorIdFilter);
        _auditLogs = response.Data;
        _totalCount = response.TotalCount;

        _loading = false;
        StateHasChanged();
    }

    private async Task FilterByEventType(string eventType)
    {
        _eventTypeFilter = eventType;
        _page = 1;
        await LoadData();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _eventTypeFilter = null;
        _actorIdFilter = null;
        _page = 1;
        await LoadData();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadData();
    }

    private async Task PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadData();
        }
    }

    private void ShowDetails(Admin.Services.AuditLog log)
    {
        _selectedLog = log;
        _showDetails = true;
    }

    private void CloseDetails()
    {
        _showDetails = false;
        _selectedLog = null;
    }

    public void Dispose()
    {
        LiveUpdate.OnAnyEvent -= HandleAnyEvent;
    }
}
