@inherits LayoutComponentBase
@implements IDisposable
@inject Admin.Services.RealtimeHubService RealtimeHub
@inject Admin.Services.LiveUpdateService LiveUpdate
@inject IHttpContextAccessor HttpContextAccessor

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">
            <span style="background: linear-gradient(90deg, #D162A4, #FF9A56); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                HellArch
            </span>
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-2 mt-1" Style="color: var(--mud-palette-text-secondary);">Admin</MudText>
        <MudSpacer />

        <MudTooltip Text="@($"Realtime: {_connectionStatus}")">
            <MudIcon Icon="@Icons.Material.Filled.Circle"
                     Size="Size.Small"
                     Style="@GetConnectionStyle()" />
        </MudTooltip>

        @if (_username is not null)
        {
            <MudText Typo="Typo.body2" Class="ml-4" Color="Color.Primary">@_username</MudText>
            <MudButton Href="/api/auth/logout" Variant="Variant.Text" Color="Color.Default" Size="Size.Small" Class="ml-2">
                Logout
            </MudButton>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle2" Style="color: var(--mud-palette-text-secondary);">NAVIGATION</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _connectionStatus = "Connecting...";
    private string? _username;
    private string? _sessionToken;
    private bool _initialized;

    protected override void OnInitialized()
    {
        // Capture HttpContext values during initial render (before SignalR takes over)
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            _username = httpContext.Items["Username"]?.ToString();
            _sessionToken = httpContext.Items["SessionToken"]?.ToString();
        }

        RealtimeHub.OnConnectionStateChanged += HandleConnectionStateChanged;
        _connectionStatus = RealtimeHub.ConnectionStateText;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            // Start live updates (idempotent - won't restart if already running)
            LiveUpdate.Start();

            // Connect to realtime hub if we have a session token
            if (!string.IsNullOrEmpty(_sessionToken))
            {
                await RealtimeHub.Connect(_sessionToken);
                _connectionStatus = RealtimeHub.ConnectionStateText;
                StateHasChanged();
            }
        }
    }

    private void HandleConnectionStateChanged(object? sender, Admin.Services.ConnectionStateChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            _connectionStatus = e.State;
            StateHasChanged();
        });
    }

    private string GetConnectionStyle() => _connectionStatus switch
    {
        "Connected" => "color: #39ff14;",
        "Reconnecting" => "color: #ffff00;",
        "Disconnected" or "Failed" => "color: #ff0033;",
        _ => "color: #737373;"
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    public void Dispose()
    {
        RealtimeHub.OnConnectionStateChanged -= HandleConnectionStateChanged;
        // Don't dispose LiveUpdate - it's a singleton shared across the app
    }
}
