<MudPaper Class="pa-3" Elevation="1">
    <div class="d-flex align-center mb-2">
        <MudIcon Icon="@HealthHelpers.GetHealthIcon(Status)"
                 Color="@HealthHelpers.GetHealthColor(Status)"
                 Size="Size.Small"
                 Class="mr-2" />
        <MudText Typo="Typo.body2" Style="font-weight: 500;">@Name</MudText>
    </div>
    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Status</MudText>
        @if (LatencyMs.HasValue)
        {
            <MonoText FontSize="0.75rem">@LatencyMs ms</MonoText>
        }
    </div>
    @if (HasError)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="mt-2">Error</MudChip>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Status { get; set; } = "";
    [Parameter] public int? LatencyMs { get; set; }
    [Parameter] public bool HasError { get; set; }
}
