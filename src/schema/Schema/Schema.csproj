<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress warnings for generated code -->
    <NoWarn>CA1724;CA1056;CA2227;CA1062;CA1861;IDE0161;CS8618;NU1608;CA1002;CA1819</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0-rc.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <!-- Include source-of-truth C# entities -->
  <ItemGroup>
    <Compile Include="..\..\..\libs\data_types\csharp\Auth\*.cs" Link="Generated\Auth\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\libs\data_types\csharp\User\*.cs" Link="Generated\User\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\libs\data_types\csharp\Events\*.cs" Link="Generated\Events\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
