# HellArch Development Environment

# Discord OAuth (fill these in)
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback

# Database URLs
AUTH_DATABASE_URL=postgres://hellarch:hellarch@localhost:5432/auth_db
USER_DATABASE_URL=postgres://hellarch:hellarch@localhost:5433/user_db

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://hellarch:hellarch@localhost:5672

# JWT Keys (generated by setup-dev.sh)
JWT_PRIVATE_KEY_PATH=./infra/keys/dev-private.pem
JWT_PUBLIC_KEY_PATH=./infra/keys/dev-public.pem

# Service addresses
GRPC_ADDRESS=:50051
HTTP_ADDRESS=:5001

# Environment
HELLARCH_ENV=development
LOG_LEVEL=debug

# Infrastructure passwords
POSTGRES_PASSWORD=hellarch
RABBITMQ_PASSWORD=hellarch

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
