# HellArch Development Environment

# Docker user mapping (prevents root-owned files in mounted volumes)
# Run: id -u && id -g to get your values
UID=1000
GID=1000

# Discord OAuth (secrets loaded from .env.secrets via SOPS)
# DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET are in encrypted secrets
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback

# Database URLs (use localhost ports for local dev, container names for docker)
AUTH_DATABASE_URL=postgres://hellarch:hellarch@localhost:5434/auth_db
USER_DATABASE_URL=postgres://hellarch:hellarch@localhost:5433/user_db

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://hellarch:hellarch@localhost:5672
RABBITMQ_USER=hellarch
# RABBITMQ_PASSWORD is in encrypted secrets (.env.secrets via SOPS)

# JWT Keys (generated by setup-dev.sh)
JWT_PRIVATE_KEY_PATH=./infra/keys/dev-private.pem
JWT_PUBLIC_KEY_PATH=./infra/keys/dev-public.pem
# JWT_SECRET is in encrypted secrets (.env.secrets via SOPS)
JWT_ISSUER=hellarch
JWT_AUDIENCE=hellarch

# Service addresses
GRPC_ADDRESS=:50051
HTTP_ADDRESS=:5001

# Environment
HELLARCH_ENV=development

# Infrastructure passwords (loaded from .env.secrets via SOPS)
# DATABASE_PASSWORD, RABBITMQ_PASSWORD, and MINIO_PASSWORD are in encrypted secrets

# MinIO (S3-compatible object storage)
# MINIO_PASSWORD is in encrypted secrets (.env.secrets via SOPS)
