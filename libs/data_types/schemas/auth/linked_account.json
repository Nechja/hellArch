{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auth/linked_account",
  "title": "LinkedAccount",
  "description": "OAuth provider linked to a user",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "provider": { "type": "string", "maxLength": 50 },
    "provider_user_id": { "type": "string", "maxLength": 255 },
    "email": { "type": ["string", "null"], "maxLength": 255 },
    "username": { "type": ["string", "null"], "maxLength": 255 },
    "avatar_url": { "type": ["string", "null"] },
    "access_token": { "type": ["string", "null"] },
    "refresh_token": { "type": ["string", "null"] },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "user_id", "provider", "provider_user_id", "created_at", "updated_at"]
}
