@namespace HellArch.Components.Dashboard

<div class="flex items-center justify-between py-4 border-b border-border last:border-0">
    <div class="flex-1 pr-4">
        <p class="font-medium text-text">@Label</p>
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="text-sm text-text-muted mt-0.5">@Description</p>
        }
    </div>
    <div class="flex-shrink-0">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
