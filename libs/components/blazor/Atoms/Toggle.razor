@namespace HellArch.Components.Atoms

<button type="button"
        role="switch"
        aria-checked="@Value"
        class="@GetToggleClass()"
        disabled="@Disabled"
        @onclick="HandleClick">
    <span class="@GetKnobClass()"></span>
</button>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ToggleSize Size { get; set; } = ToggleSize.Default;
    [Parameter] public string? Class { get; set; }

    private async Task HandleClick()
    {
        if (Disabled)
        {
            return;
        }

        Value = !Value;
        await ValueChanged.InvokeAsync(Value);
    }

    private string GetToggleClass()
    {
        var baseClass = Size switch
        {
            ToggleSize.Small => "toggle-sm",
            ToggleSize.Large => "toggle-lg",
            _ => "toggle"
        };

        var stateClass = Value ? " toggle-on" : "";
        var disabledClass = Disabled ? " opacity-50 cursor-not-allowed" : "";
        var custom = !string.IsNullOrEmpty(Class) ? $" {Class}" : "";

        return $"{baseClass}{stateClass}{disabledClass}{custom}";
    }

    private string GetKnobClass()
    {
        var baseClass = Size switch
        {
            ToggleSize.Small => "toggle-knob-sm",
            ToggleSize.Large => "toggle-knob-lg",
            _ => "toggle-knob"
        };

        return Value ? $"{baseClass} toggle-knob-on" : baseClass;
    }

    public enum ToggleSize { Default, Small, Large }
}
