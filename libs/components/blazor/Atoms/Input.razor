@namespace HellArch.Components.Atoms

<input type="@Type"
       class="@GetInputClass()"
       value="@Value"
       placeholder="@Placeholder"
       disabled="@Disabled"
       @oninput="HandleInput" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public InputState State { get; set; } = InputState.Default;
    [Parameter] public InputSize Size { get; set; } = InputSize.Default;
    [Parameter] public string? Class { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string GetInputClass()
    {
        var stateClass = State switch
        {
            InputState.Error => "input-error",
            InputState.Success => "input-success",
            _ => "input"
        };

        var sizeClass = Size switch
        {
            InputSize.Small => " input-sm",
            _ => ""
        };

        var custom = !string.IsNullOrEmpty(Class) ? $" {Class}" : "";
        return $"{stateClass}{sizeClass}{custom}";
    }

    public enum InputState { Default, Error, Success }
    public enum InputSize { Default, Small }
}
